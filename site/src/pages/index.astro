---
/**
 * Composição da página na ordem de montagem do PLANO §3 (ordem ajustada §10.24:
 * Autoridade ANTES da oferta — primeiro sinal de confiança antes do pedido de conversa).
 * TrustBar e ProvaSocial não renderizam na v1 (§10.8): componentes com estrutura
 * comentada, saída vazia.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustMarquee from '../components/TrustMarquee.astro';
import TrustBar from '../components/TrustBar.astro';
import Video from '../components/Video.astro';
import Problema from '../components/Problema.astro';
import ParaQuem from '../components/ParaQuem.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Autoridade from '../components/Autoridade.astro';
import Oferta from '../components/Oferta.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import WaFab from '../components/WaFab.astro';
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <TrustMarquee />
    <TrustBar />
    <Video />
    <Problema />
    <ParaQuem />
    <ComoFunciona />
    <Autoridade />
    <Oferta />
    <ProvaSocial />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <StickyCta />
  <WaFab />
</Base>
