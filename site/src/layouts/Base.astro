---
/**
 * Layout base (PLANO §6): head completo, skip-link, tema claro travado.
 */
import '../styles/global.css';
import { SITE_URL } from '../config';
import copy from '../copy.json';

const canonical = new URL(import.meta.env.BASE_URL, SITE_URL).href;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, SITE_URL).href;

/* Metadados saem de src/copy.json, a mesma fonte do hero (regra do Mateus, 2026-07-24:
   mudou título/eyebrow do hero, muda a OG junto). Nada de string solta aqui. */
const { title, description, ogTitle, ogDescription, ogImageAlt } = copy.meta;
---

<html lang="pt-BR">
  <head>
    {/* Marca JS ativo o quanto antes: só então os elementos .reveal começam ocultos
        (sem JS/reduced-motion nada fica escondido — a11y PLANO §8). */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Ritma Registros" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#EBE8E2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/catamaran-var.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    {/* Glifo oficial do WhatsApp, monocromático — único ícone da página (PLANO §1, §10.19).
        Definido uma vez; as instâncias do CTA consomem via <use>. */}
    <svg aria-hidden="true" style="display:none">
      <symbol id="wa-icon" viewBox="0 0 24 24">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </symbol>
    </svg>
    <slot />

    {/* Revelação no scroll (redesign): observa .reveal e libera ao entrar na viewport.
        Uma vez visível, para de observar (não re-esconde). Respeita prefers-reduced-motion. */}
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nodes = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          nodes.forEach(function (n) {
            n.classList.add('is-in');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
        );
        nodes.forEach(function (n) {
          io.observe(n);
        });
      })();
    </script>
  </body>
</html>
