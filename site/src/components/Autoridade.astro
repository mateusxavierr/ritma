---
/**
 * Autoridade (redesign 2026-07-23 — faixa escura, rosto real em destaque).
 * Nome, rosto e papel ANTES do pedido de conversa (PLANO §5.9, §10.24).
 * Foto: photo 7 (Amanda sentada, olhar direto, fundo escuro) fundindo na faixa via máscara.
 */
import { Picture } from 'astro:assets';
import amanda from '../assets/autoridade.jpg';
---

<section class="band-dark autoridade">
  <div class="container-page autoridade__grid">
    <div class="autoridade__figure reveal">
      <Picture
        src={amanda}
        alt="Amanda Pereira, da Ritma Registros"
        formats={['avif', 'webp']}
        widths={[440, 660, 880]}
        sizes="(min-width: 1024px) 440px, 100vw"
        quality={82}
        loading="lazy"
        class="autoridade__photo"
      />
    </div>
    <div class="autoridade__text">
      <p class="autoridade__eyebrow reveal">Quem acompanha o seu registro</p>
      <p class="autoridade__nome reveal" style="--reveal-delay:80ms">Amanda Pereira</p>
      <p class="autoridade__papel reveal" style="--reveal-delay:140ms">Registro de Marcas</p>
      <p class="autoridade__bio reveal" style="--reveal-delay:200ms">
        À frente da Ritma Registros, Amanda cuida de processos de marca com atendimento digital para
        todo o Brasil.
      </p>
      {/*
        [PENDENTE:BIO] — cobre APENAS o texto da mini-bio (formação, nº OAB, tempo de atuação —
        PERGUNTAS-ABERTAS 11). Quando chegar, substitui o parágrafo fallback acima.
        A foto NÃO depende deste placeholder (Adendo do BRIEF).
      */}
    </div>
  </div>
</section>

<style>
  .autoridade__grid {
    display: grid;
    gap: 32px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  @media (min-width: 1024px) {
    .autoridade__grid {
      grid-template-columns: 0.82fr 1fr;
      gap: 56px;
      padding-top: 96px;
      padding-bottom: 96px;
    }
  }

  .autoridade__figure {
    position: relative;
  }
  .autoridade__photo {
    display: block;
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
    border-radius: 16px;
    /* funde a base e as laterais na faixa escura */
    -webkit-mask-image: linear-gradient(180deg, #000 74%, transparent),
      linear-gradient(90deg, transparent, #000 12% 88%, transparent);
    mask-image: linear-gradient(180deg, #000 74%, transparent),
      linear-gradient(90deg, transparent, #000 12% 88%, transparent);
  }
  @media (min-width: 1024px) {
    .autoridade__photo {
      max-width: 440px;
      margin-inline: 0;
    }
  }

  .autoridade__eyebrow {
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark-soft);
    margin-bottom: 16px;
  }
  .autoridade__nome {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.375rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-on-dark);
  }
  .autoridade__papel {
    margin-top: 6px;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--text-on-dark-soft);
  }
  .autoridade__bio {
    margin-top: 20px;
    max-width: 46ch;
    color: var(--text-on-dark-soft);
  }
</style>
