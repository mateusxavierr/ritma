---
/**
 * Autoridade (redesign 2026-07-24 — copy aprofundada, mais autoridade, estilo da referência).
 * Rosto real + nome + papel + credenciais + citação, ANTES do pedido de conversa (§5.9, §10.24).
 * Foto: photo 7 (Amanda, olhar direto, fundo escuro) fundindo na faixa via máscara.
 *
 * REGRA (feedback do Mateus): não inventar. O que NÃO temos confirmado (formação, OAB, tempo de
 * atuação, nº de marcas, citação real) entra como PLACEHOLDER AMARELO visível (.ph) — impossível
 * confundir com final. Some quando a Amanda preencher (PERGUNTAS-ABERTAS 11).
 * O que é real/sabido está escrito de verdade (Ritma, INPI/PI, atendimento nacional, @ritmaregistros).
 */
import { Picture } from 'astro:assets';
import amanda from '../assets/autoridade.jpg';
---

<section class="band-dark autoridade">
  <div class="container-page autoridade__grid">
    <div class="autoridade__figure reveal">
      <Picture
        src={amanda}
        alt="Amanda Pereira, da Ritma Registros"
        formats={['avif', 'webp']}
        widths={[440, 660, 880]}
        sizes="(min-width: 1024px) 440px, 100vw"
        quality={82}
        loading="lazy"
        class="autoridade__photo"
      />
    </div>
    <div class="autoridade__text">
      <p class="autoridade__eyebrow reveal">Quem vai cuidar da sua marca</p>
      <p class="autoridade__nome reveal" style="--reveal-delay:80ms">Amanda Pereira</p>
      <p class="autoridade__papel reveal" style="--reveal-delay:120ms">
        Especialista em Registro de Marcas
        <span class="ph">OAB/PE 000.000 — confirmar nº</span>
      </p>

      {/* Credenciais — estrutura de autoridade (todas placeholder até a Amanda confirmar) */}
      <ul class="autoridade__creds reveal" style="--reveal-delay:180ms">
        <li><span class="ph">Formação — ex.: Direito, [Universidade]</span></li>
        <li><span class="ph">Especialização em Propriedade Intelectual — confirmar</span></li>
        <li><span class="ph">Atua com marcas há [X] anos / desde [ano]</span></li>
      </ul>

      <div class="autoridade__bio reveal" style="--reveal-delay:240ms">
        <p>
          À frente da Ritma Registros, Amanda conduz processos de registro de marca no INPI e
          proteção de propriedade intelectual, com atendimento digital para todo o Brasil.
        </p>
        <p>
          <span class="ph"
            >Trajetória da Amanda — quando começou, o que a levou a se dedicar a marcas, casos ou
            números que dão autoridade. Escreva com ela; isso é o coração desta seção.</span
          >
        </p>
        <p>
          Seu trabalho vai além do protocolo: definição da classe certa, acompanhamento de cada
          despacho do INPI e uma conversa sem juridiquês — pra você entender e decidir cada passo
          com segurança.
        </p>
      </div>

      {/* Citação — dá muita autoridade e humaniza. Frase REAL da Amanda (não inventar). */}
      <blockquote class="autoridade__quote reveal" style="--reveal-delay:300ms">
        <span class="ph"
          >Frase da Amanda sobre por que proteger a marca importa — 1 ou 2 linhas, com a voz dela.</span
        >
      </blockquote>

      <a
        href="https://www.instagram.com/ritmaregistros"
        rel="noopener"
        class="autoridade__ig reveal"
        style="--reveal-delay:340ms"
      >
        Acompanhe no Instagram
        <span>@ritmaregistros</span>
      </a>
    </div>
  </div>
</section>

<style>
  .autoridade__grid {
    display: grid;
    gap: 32px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  @media (min-width: 1024px) {
    .autoridade__grid {
      grid-template-columns: 0.82fr 1fr;
      gap: 56px;
      padding-top: 96px;
      padding-bottom: 96px;
    }
  }

  .autoridade__figure {
    position: relative;
  }
  .autoridade__photo {
    display: block;
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
    border-radius: 16px;
    -webkit-mask-image: linear-gradient(180deg, #000 74%, transparent),
      linear-gradient(90deg, transparent, #000 12% 88%, transparent);
    mask-image: linear-gradient(180deg, #000 74%, transparent),
      linear-gradient(90deg, transparent, #000 12% 88%, transparent);
  }
  @media (min-width: 1024px) {
    .autoridade__photo {
      max-width: 440px;
      margin-inline: 0;
    }
  }

  .autoridade__eyebrow {
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark-soft);
    margin-bottom: 16px;
  }
  .autoridade__nome {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.375rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-on-dark);
  }
  .autoridade__papel {
    margin-top: 8px;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--text-on-dark-soft);
  }

  .autoridade__creds {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .autoridade__creds li {
    position: relative;
    padding-left: 18px;
    font-size: var(--text-body-sm);
    color: var(--text-on-dark-soft);
  }
  .autoridade__creds li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    background: var(--text-on-dark-soft);
  }

  .autoridade__bio {
    margin-top: 22px;
    max-width: 52ch;
    color: var(--text-on-dark-soft);
    display: grid;
    gap: 14px;
  }

  .autoridade__quote {
    margin: 24px 0 0;
    padding-left: 18px;
    border-left: 2px solid var(--text-on-dark-soft);
    max-width: 48ch;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--text-on-dark);
  }

  .autoridade__ig {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 24px;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--text-on-dark-soft);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .autoridade__ig span {
    color: var(--text-on-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .autoridade__ig:hover {
    color: var(--text-on-dark);
  }

  /* ——— Marcador de PLACEHOLDER (some quando preenchido) — feedback do Mateus.
     Amarelo tracejado, óbvio: NÃO é design final, é lembrete de conteúdo a preencher. ——— */
  :global(.ph) {
    background: #fde68a;
    color: #7c2d12;
    border: 1px dashed #b45309;
    border-radius: 4px;
    padding: 1px 6px;
    font-weight: 600;
    font-style: normal;
    text-decoration: none;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
</style>
