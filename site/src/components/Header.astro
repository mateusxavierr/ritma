---
/**
 * Header flutuante (redesign 2026-07-23).
 * — No topo, sobre o hero escuro: barra transparente, logo OSSO, CTA outline claro.
 * — Ao rolar (>8px): vira uma PÍLULA osso flutuante (cantos arredondados + sombra + leve
 *   recuo do topo), logo CHUMBO, CTA sólido. z-index 30 < 40 da sticky bar (§5.12).
 * Mantém o CTA único: mesmo href/label/intent de config.ts.
 */
import logoChumbo from '../assets/logo-ritma-chumbo.svg';
import logoOsso from '../assets/logo-ritma-osso.svg';
import CtaButton from './CtaButton.astro';
import { CTA_ARIA_LABEL, waHref } from '../config';
---

<header class="site-header">
  <div class="container-page">
    <div class="nav">
      <a href="#conteudo" class="nav__brand" aria-label="Ritma Registros — início">
        <img src={logoOsso.src} alt="Ritma Registros" width="103" height="26" class="nav__logo nav__logo--osso" />
        <img src={logoChumbo.src} alt="" aria-hidden="true" width="103" height="26" class="nav__logo nav__logo--ink" />
      </a>

      <a href={waHref()} aria-label={CTA_ARIA_LABEL} class="nav__wa md:hidden">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <use href="#wa-icon"></use>
        </svg>
        <span>WhatsApp</span>
      </a>
      <div class="hidden md:block">
        <CtaButton size="sm" />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    var update = function () {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    padding-top: 10px;
    transition: padding-top 200ms ease;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 56px;
    padding: 0 8px 0 4px;
    border-radius: 16px;
    border: 1px solid transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      backdrop-filter 220ms ease;
  }

  /* Pílula flutuante ao rolar */
  .site-header.is-scrolled {
    padding-top: 14px;
  }
  .site-header.is-scrolled .nav {
    background-color: color-mix(in srgb, var(--surface-alt) 88%, transparent);
    border-color: var(--border-subtle);
    box-shadow:
      0 1px 2px rgb(46 48 48 / 0.06),
      0 10px 30px rgb(46 48 48 / 0.1);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    backdrop-filter: saturate(1.4) blur(10px);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    padding: 8px;
    line-height: 0;
  }
  .nav__logo {
    display: block;
    height: 22px;
    width: auto;
    transition: opacity 200ms ease;
  }
  @media (min-width: 768px) {
    .nav__logo {
      height: 26px;
    }
  }
  /* topo sobre hero escuro → osso; ao rolar → chumbo (pílula clara) */
  .nav__logo--ink {
    position: absolute;
    opacity: 0;
  }
  .site-header.is-scrolled .nav__logo--osso {
    opacity: 0;
  }
  .site-header.is-scrolled .nav__logo--ink {
    position: static;
    opacity: 1;
  }

  /* CTA mobile: outline claro sobre o hero; ao rolar acompanha a pílula clara */
  .nav__wa {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid color-mix(in srgb, var(--sand-100) 45%, transparent);
    border-radius: 12px;
    color: var(--text-on-dark);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
    text-decoration: none;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .site-header.is-scrolled .nav__wa {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }
  .nav__wa::after {
    content: '';
    position: absolute;
    inset: -6px 0;
  }
  @media (min-width: 48rem) {
    .nav__wa {
      display: none;
    }
  }

  /* CTA desktop do header: outline claro sobre o hero escuro; sólido chumbo ao rolar */
  .site-header :global(.cta-solid) {
    background-color: transparent;
    color: var(--text-on-dark);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sand-100) 42%, transparent);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }
  .site-header :global(.cta-solid:hover) {
    background-color: color-mix(in srgb, var(--sand-100) 12%, transparent);
  }
  .site-header.is-scrolled :global(.cta-solid) {
    background-color: var(--cta-bg);
    color: var(--cta-text);
    box-shadow: none;
  }
  .site-header.is-scrolled :global(.cta-solid:hover) {
    background-color: var(--cta-bg-hover);
  }
</style>
