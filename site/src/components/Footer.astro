---
/**
 * Footer sóbrio (PLANO §5.11, §4.14): continuidade do bloco escuro de fechamento.
 * Dados publicados pela própria marca (papelaria oficial); sem telefone (§10.12).
 */
import logoOsso from '../assets/logo-ritma-osso.svg';
---

<footer class="bloco-escuro footer-dark text-(--text-on-inverse-2)">
  <div class="container-page grid gap-10 py-12 md:grid-cols-3 md:py-16">
    <div>
      <img src={logoOsso.src} alt="Ritma Registros" width="103" height="26" class="h-6 w-auto" />
      {/* Identificação profissional (2026-07-24): quem assina o contrato é a Amanda como
          ADVOGADA — a Ritma não tem CNPJ, e por isso o rodapé traz nome + OAB + endereço,
          que é o que a publicidade da advocacia pede. Fecha [PENDENTE:CNPJ]. */}
      <p class="mt-4 text-body-sm">Amanda Roberta Pereira, OAB/PE 57.651</p>
      <p class="text-body-sm">Rua Rosemiro Alves da Rocha, 342, Centro</p>
      <p class="text-body-sm">Santa Cruz do Capibaribe, PE</p>
      <p class="text-body-sm">Atendimento digital para todo o Brasil</p>
    </div>
    <div>
      <a
        href="https://www.instagram.com/ritmaregistros"
        rel="noopener"
        class="flex min-h-12 items-center text-body-sm underline-offset-4 hover:underline"
        >@ritmaregistros</a
      >
      <a
        href="mailto:ritmaregistros@gmail.com"
        class="flex min-h-12 items-center text-body-sm underline-offset-4 hover:underline"
        >ritmaregistros@gmail.com</a
      >
    </div>
    <div class="md:text-right">
      <p class="text-caption">© 2026 Ritma Registros. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<!-- ANALYTICS: inserir tags aqui quando os IDs chegarem (PERGUNTAS-ABERTAS 9) -->

<style>
  /* Separador do CTA final (§5.11): osso a 15% */
  footer {
    border-top: 1px solid rgb(235 232 226 / 0.12);
    --focus-ring: var(--text-on-inverse-2);
  }
  /* Continua o tom escuro do CTA final sem emenda (bottom do band-dark = ink-950) */
  .footer-dark {
    background-color: var(--surface-dark-bottom);
  }

  /* O dark do footer fecha a página (must-fix 5): o respiro do safe-area mobile
     fica DENTRO do bloco escuro, não como padding branco do body. */
  @media (max-width: 767.98px) {
    footer {
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
</style>
