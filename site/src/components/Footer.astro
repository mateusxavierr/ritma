---
/**
 * Footer sóbrio (PLANO §5.11, §4.14): continuidade do bloco escuro de fechamento.
 *
 * WHATSAPP NO RODAPÉ (2026-08-06, pedido do Mateus). O §10.12 mandava rodapé sem telefone, mas
 * a razão era "o telefone é o dado marcado como pendente no BRIEF, não assumir" — e essa razão
 * venceu: o número foi confirmado pelo Mateus em 2026-07-23 e mora no config desde então. Nada
 * é contrariado aqui, só uma trava que perdeu o motivo.
 *
 * Ícones só NESTA coluna: contato é lista de canais, onde o glifo orienta a varredura. A coluna
 * de identificação (nome, OAB, endereço) segue tipográfica — pino de mapa e chapéu de formatura
 * ali seriam decoração, que é o que o §10.19 existe pra impedir.
 */
import logoOsso from '../assets/logo-ritma-osso.svg';
import { WHATSAPP_DISPLAY, waHref } from '../config';

/* Ano do BUILD, não do acesso: em página estática não existe "agora" do visitante sem JS. Some
   o risco de o rodapé envelhecer sozinho enquanto o site for republicado ao menos uma vez ao ano. */
const ano = new Date().getFullYear();

const contatos = [
  { glifo: 'wa-icon', solido: true, href: waHref('rodape'), texto: WHATSAPP_DISPLAY, externo: true },
  {
    glifo: 'ig-icon',
    href: 'https://www.instagram.com/ritmaregistros',
    texto: '@ritmaregistros',
    externo: true,
  },
  {
    glifo: 'ig-icon',
    href: 'https://www.instagram.com/amandapereiraadv_/',
    texto: '@amandapereiraadv_',
    externo: true,
  },
  { glifo: 'mail-icon', href: 'mailto:ritmaregistros@gmail.com', texto: 'ritmaregistros@gmail.com' },
];

/* Endereço clicável (2026-08-06): negócio local com endereço em texto morto obriga quem quer
   conferir se existe escritório de verdade a copiar e colar. Formato /maps/search com api=1 é o
   documentado pelo Google e o único que não depende de place_id — endereço muda, o link segue. */
const ENDERECO = ['Rua Rosemiro Alves da Rocha, 342, Centro', 'Santa Cruz do Capibaribe, PE'];
const MAPS_HREF = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${ENDERECO.join(', ')}, Brasil`
)}`;
---

<footer class="bloco-escuro footer-dark text-(--text-on-inverse-2)">
  <div class="container-page grid gap-10 py-12 md:grid-cols-3 md:py-16">
    <div>
      <img src={logoOsso.src} alt="Ritma Registros" width="103" height="26" class="h-6 w-auto" />
      {/* Identificação profissional (2026-07-24): quem assina o contrato é a Amanda Pereira
          como ADVOGADA — a Ritma não tem CNPJ, e por isso o rodapé traz nome + OAB + endereço,
          que é o que a publicidade da advocacia pede. Fecha [PENDENTE:CNPJ].
          2026-07-28: nome do rodapé alinhado ao resto do site (era o nome civil completo).
          O site inteiro chama a advogada de "Amanda Pereira" — nome único, sem variação. */}
      <p class="mt-4 text-body-sm">Amanda Pereira, OAB/PE 57.651</p>
      <a href={MAPS_HREF} target="_blank" rel="noopener" class="rodape-endereco text-body-sm">
        {ENDERECO.map((linha) => <span>{linha}</span>)}
      </a>
      <p class="text-body-sm">Atendimento digital para todo o Brasil</p>
    </div>
    <div>
      {
        contatos.map((c) => (
          <a
            href={c.href}
            class="rodape-link"
            target={c.externo ? '_blank' : undefined}
            rel={c.externo ? 'noopener' : undefined}
          >
            <span class="rodape-link__glifo" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width={c.solido ? 16 : 18}
                height={c.solido ? 16 : 18}
                fill={c.solido ? 'currentColor' : 'none'}
              >
                <use href={`#${c.glifo}`} />
              </svg>
            </span>
            <span class="text-body-sm">{c.texto}</span>
          </a>
        ))
      }
    </div>
    {/* COLUNA LEGAL (2026-08-06). Estava com só o copyright e sobrando vazio; o Mateus mandou
        pôr ali o que faltava. Ordem proposital: o aviso da OAB primeiro, porque é ele que
        enquadra a página inteira; a política depois, porque é destino; o copyright por último,
        que é o menos importante dos três e estava sozinho ocupando a coluna. */}
    <div class="rodape-legal md:text-right">
      {/* ⚠️ Redação não revisada pela Amanda. Enquadramento do Provimento 205/2021 do CFOAB:
          publicidade da advocacia é informativa, não pode captar clientela nem prometer
          resultado. A página já obedece isso na prática desde 2026-07-24 (sem "grátis", sem
          valor de honorário, sem promessa) — a linha só declara o que já é verdade. */}
      <p class="text-caption rodape-legal__aviso">
        Conteúdo de caráter informativo, sem captação de clientela nem promessa de resultado
        (Provimento 205/2021, CFOAB).
      </p>
      <a href={`${import.meta.env.BASE_URL}politica-de-privacidade/`} class="text-caption"
        >Política de privacidade</a
      >
      <p class="text-caption rodape-legal__copy">
        © {ano} Ritma Registros. Todos os direitos reservados.
      </p>
      <!-- UTM de propósito (skill /rodape-rastreavel): utm_source = este cliente. Sem ele a visita cai em "direto" no GA4 da MXC. Não tirar ao mexer no selo. -->
      <a
        class="rodape-mxc text-caption"
        href="https://mxcdigital.com.br/?utm_source=ritma&amp;utm_medium=rodape&amp;utm_campaign=assinatura"
        target="_blank"
        rel="noopener"
        aria-label="Feito por MXC Digital (abre em nova aba)"
      >
        <span>Feito por</span>
        <img src="/mxc-logo-claro.webp" width="281" height="64" alt="" loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<!-- ANALYTICS: inserir tags aqui quando os IDs chegarem (PERGUNTAS-ABERTAS 9) -->

<style>
  /* Separador do CTA final (§5.11): osso a 15% */
  footer {
    border-top: 1px solid rgb(235 232 226 / 0.12);
    --focus-ring: var(--text-on-inverse-2);
  }
  /* Continua o tom escuro do CTA final sem emenda (bottom do band-dark = ink-950) */
  .footer-dark {
    background-color: var(--surface-dark-bottom);
  }

  /* Coluna legal: três blocos de peso decrescente. O aviso da OAB é o único texto do rodapé em
     medida curta de propósito — 34ch força quebra em três linhas e ele lê como nota de rodapé,
     não como parágrafo. Na coluna alinhada à direita, a medida encosta na borda direita. */
  .rodape-legal__aviso {
    max-width: 34ch;
    opacity: 0.78;
  }
  @media (min-width: 768px) {
    .rodape-legal__aviso {
      margin-left: auto;
    }
  }
  .rodape-legal a {
    display: inline-block;
    margin-top: 16px;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgb(235 232 226 / 0.35);
    transition: text-decoration-color 200ms ease;
  }
  .rodape-legal a:hover {
    text-decoration-color: currentColor;
  }
  /* O copyright desce e apaga: é o item menos importante da coluna e não pode competir com o
     link, que é o único destino clicável daqui. */
  .rodape-legal__copy {
    margin-top: 20px;
    opacity: 0.62;
  }

  /* Selo de autoria: última linha, logo abaixo do ©. Logo na variante clara ("digital" em
     branco) porque o fundo é o ink-950. O texto fica a 85% do osso (8,3:1 sobre #2E3030) — mais
     apagado que o resto do rodapé, mas acima do 7:1. Hover só acende a cor: nada se mexe. */
  .rodape-legal a.rodape-mxc {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 12px;
    text-decoration: none;
    color: color-mix(in srgb, var(--text-on-inverse-2) 85%, var(--surface-dark-bottom));
    transition: color 200ms ease;
  }
  .rodape-legal a.rodape-mxc:hover {
    color: var(--text-on-inverse-2);
  }
  .rodape-mxc img {
    height: 26px;
    width: auto;
  }

  /* Endereço vira link pro Maps sem parecer botão: mesma cor e mesmo peso do resto do bloco de
     identificação, sublinha só no hover. As duas linhas juntas já dão ~44px de alvo. */
  .rodape-endereco {
    display: block;
  }
  .rodape-endereco span {
    display: block;
  }
  .rodape-endereco:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Linha de contato: glifo + texto.
     ALTURA (2026-08-06, pedido do Mateus pra apertar): 32px no ponteiro fino, 44px no grosso.
     A média era 48px em todo lugar e sobrava ar entre quatro linhas de uma linha só. O corte é
     por TIPO DE PONTEIRO e não por largura de tela, porque quem manda no tamanho do alvo é o
     dedo, não o viewport — tablet largo continua com alvo de dedo. Os 44px do toque são o piso
     do critério AAA da WCAG (2.5.5); abaixo disso eu não desço com quatro links colados. */
  .rodape-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
  }
  @media (pointer: coarse) {
    .rodape-link {
      min-height: 44px;
    }
  }
  /* Caixa de 18px: alinha os quatro numa coluna só. O glifo do WhatsApp desenha 16px dentro
     dela de propósito — sólido do mesmo tamanho de um de traço pesa mais no olho, e o que tem
     que ficar igual é o peso aparente, não o número. */
  .rodape-link__glifo {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    opacity: 0.62;
    transition: opacity 200ms ease;
  }
  /* Entra apagado e acende no hover: no escuro, ícone em contraste cheio compete com o texto,
     que é quem carrega a informação. */
  .rodape-link:hover .rodape-link__glifo {
    opacity: 1;
  }
  /* Sublinhado só no texto: glifo sublinhado vira rabisco. */
  .rodape-link:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* O dark do footer fecha a página (must-fix 5): o respiro do safe-area mobile
     fica DENTRO do bloco escuro, não como padding branco do body. */
  @media (max-width: 767.98px) {
    footer {
      padding-bottom: env(safe-area-inset-bottom);
    }
  }
</style>
