---
/**
 * Oferta (redesign 2026-07-24 — composição do panfleto A6).
 * O H2 é a copy do panfleto; a papelaria traz o R cerâmico ao lado da oferta. Reproduz isso:
 * R cerâmico grande à esquerda (com um respiro radial atrás pra não sumir tom-sobre-tom no osso)
 * + card da oferta à direita, com a única sombra permitida da página (§2.3).
 * Faixa clara (osso) — mantém a alternância claro/escuro.
 */
import { Picture } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import rCeramico from '../assets/r-ceramico.png';
---

<section class="oferta bg-(--surface-alt)">
  <div class="container-page oferta__grid">
    <div class="oferta__r reveal" aria-hidden="true">
      <span class="oferta__r-halo"></span>
      <Picture
        src={rCeramico}
        alt=""
        formats={['avif', 'webp']}
        widths={[320, 480, 700, 900]}
        sizes="(min-width: 1024px) 420px, 60vw"
        class="oferta__r-img"
      />
    </div>

    <div class="oferta-card card-lift reveal" style="--reveal-delay:120ms">
      <h2 class="text-h2 oferta-card__title">Muito além de um processo burocrático</h2>
      <p class="oferta-card__lead">
        Uma assessoria estratégica que assume a burocracia por você — do primeiro protocolo ao
        acompanhamento até a decisão final.
      </p>

      <p class="oferta-card__label">Incluído na assessoria</p>
      {/*
        [PENDENTE:SERVICOS] — escopo definicional abaixo; validar contra a lista real
        da agência quando chegar (PERGUNTAS-ABERTAS 1).
      */}
      <ul class="oferta-checklist">
        <li>Consulta de viabilidade e análise de colidência</li>
        <li>Definição de classes e estratégia de proteção</li>
        <li>Preparação e protocolo do pedido no INPI</li>
        <li>Acompanhamento do processo e aviso de cada despacho</li>
        <li>Atendimento digital para todo o Brasil</li>
      </ul>

      <p class="oferta-card__nota">
        <strong>Sobre os custos:</strong> todo registro de marca envolve a taxa oficial do INPI, que
        parte de R$ 440 por classe para MEI, micro e pequenas empresas e pessoas físicas.
      </p>
      {/*
        Variante pós-liberação (§10.23), trocar a nota acima por:
        `Registrar uma marca tem dois custos: a taxa oficial do INPI, que parte de R$ 440 por
        classe para MEI, micro e pequenas empresas e pessoas físicas, e os honorários da
        assessoria, que dependem do seu caso e são apresentados com clareza antes de qualquer
        contratação.`

        [PENDENTE:PRECO] — linha de preço/parcelamento entra aqui quando confirmada
        (PERGUNTAS-ABERTAS 2).

        [PENDENTE:GARANTIA] — linha de risk reversal entra aqui SÓ se a Amanda confirmar
        (PERGUNTAS-ABERTAS 3).
      */}
      <div class="oferta-card__cta">
        <CtaButton block align="center" origin="oferta" />
      </div>
    </div>
  </div>
</section>

<style>
  .oferta {
    overflow: hidden;
  }
  .oferta__grid {
    display: grid;
    gap: 24px;
    align-items: center;
    padding-block: 64px;
  }
  @media (min-width: 1024px) {
    .oferta__grid {
      grid-template-columns: 0.85fr 1fr;
      gap: 40px;
      padding-block: 96px;
    }
  }

  /* R cerâmico */
  .oferta__r {
    position: relative;
    display: flex;
    justify-content: center;
    isolation: isolate;
  }
  /* Mobile: esconde o R (opção A do Mateus) — a composição R+card só faz sentido lado a lado;
     no mobile a oferta lidera e o R só comeria espaço vertical. */
  @media (max-width: 1023.98px) {
    .oferta__r {
      display: none;
    }
  }
  .oferta__r-img {
    position: relative;
    z-index: 1;
    display: block;
    width: min(240px, 55vw);
    height: auto;
    filter: drop-shadow(0 24px 40px rgb(76 78 78 / 0.22));
  }
  @media (min-width: 1024px) {
    .oferta__r-img {
      width: 100%;
      max-width: 420px;
      margin-left: -12px; /* leve bleed pra esquerda, como no panfleto */
    }
  }
  /* respiro radial atrás do R — separa do osso sem virar faixa escura */
  .oferta__r-halo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      52% 46% at 50% 52%,
      rgb(76 78 78 / 0.08),
      transparent 70%
    );
  }

  .oferta-card {
    position: relative;
    background: var(--surface-page);
    border-radius: 18px;
    padding: 34px 24px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .oferta-card {
      padding: 48px 48px 44px;
    }
  }
  /* acento no topo do card — toque "desenhado" que casa com as etapas */
  .oferta-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--ink-700);
  }

  .oferta-card__title {
    margin-top: 4px;
  }
  .oferta-card__lead {
    margin-top: 12px;
    color: var(--text-secondary);
  }

  .oferta-card__label {
    margin-top: 28px;
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Checklist — círculo + check em CSS (sem lib de ícone), reforça "você recebe isto" */
  .oferta-checklist {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .oferta-checklist li {
    position: relative;
    padding-left: 32px;
    color: var(--text-primary);
  }
  .oferta-checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
  }
  .oferta-checklist li::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    width: 5px;
    height: 9px;
    border-right: 2px solid var(--ink-700);
    border-bottom: 2px solid var(--ink-700);
    transform: rotate(45deg);
  }

  /* Nota de custo — separada por filete, lê como transparência/confiança, não como item */
  .oferta-card__nota {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-secondary);
  }
  .oferta-card__nota strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  .oferta-card__cta {
    margin-top: 28px;
  }
</style>
