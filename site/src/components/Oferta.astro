---
/**
 * Oferta (redesign 2026-07-24 — composição do panfleto A6).
 * O H2 é a copy do panfleto; a papelaria traz o R cerâmico ao lado da oferta. Reproduz isso:
 * R cerâmico grande à esquerda (com um respiro radial atrás pra não sumir tom-sobre-tom no osso)
 * + card da oferta à direita, com a única sombra permitida da página (§2.3).
 * Faixa clara (osso) — mantém a alternância claro/escuro.
 */
import { Picture } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import rCeramico from '../assets/r-ceramico.png';
---

<section class="oferta band-light">
  <div class="container-page oferta__grid">
    <div class="oferta__r reveal" aria-hidden="true">
      <Picture
        src={rCeramico}
        alt=""
        formats={['avif', 'webp']}
        widths={[320, 480, 700, 900]}
        sizes="(min-width: 1024px) 420px, 60vw"
        class="oferta__r-img"
      />
    </div>

    <div class="oferta-card card-lift reveal" style="--reveal-delay:120ms">
      <h2 class="text-h2 oferta-card__title">Muito além de um processo burocrático</h2>
      <p class="oferta-card__lead">
        Uma assessoria estratégica que assume a burocracia por você — do primeiro protocolo ao
        acompanhamento até a decisão final.
      </p>

      {/* Lista REAL confirmada pela Amanda em 2026-07-24 (fecha [PENDENTE:SERVICOS]). */}
      <p class="oferta-card__label">Incluído na assessoria</p>
      <ul class="oferta-checklist">
        <li>Consulta de viabilidade e análise de colidência</li>
        <li>Orientação sobre o tipo de marca: nominativa, mista, figurativa ou tridimensional</li>
        <li>Definição de classes e estratégia de proteção</li>
        <li>Preparação e protocolo do pedido no INPI</li>
        <li>Acompanhamento do processo e aviso de cada despacho</li>
        <li>Atendimento digital para todo o Brasil</li>
      </ul>

      {/* Serviços que a Amanda faz mas NÃO entram no plano básico — ela orça caso a caso
          ("é difícil alguém fechar um pacote que inclui tudo, porque sai mais caro").
          Marcador é "+", nunca check: check ao lado de item não incluído é promessa falsa. */}
      <p class="oferta-card__label">Quando o caso pede, orçado à parte</p>
      <ul class="oferta-extras">
        <li>Resposta a exigências do INPI</li>
        <li>Defesa contra oposições e oposição a pedidos de terceiros</li>
        <li>Recursos administrativos</li>
        <li>Petições de retificação de dados</li>
        <li>Monitoramento de marcas semelhantes (colidências)</li>
        <li>Renovação do registro, a cada 10 anos</li>
        <li>Averbação de alteração de nome, endereço ou razão social</li>
        <li>Transferência de titularidade (cessão de marca)</li>
      </ul>

      {/* Texto de honorários na formulação que a própria Amanda validou como OAB-safe:
          sem valor, sem "a partir de" (fecha [PENDENTE:PRECO] e [PENDENTE:GARANTIA] —
          não existe garantia; o que existe é orçamento por caso). */}
      <p class="oferta-card__nota">
        Os honorários são definidos de acordo com as particularidades de cada caso. Entre em
        contato para receber uma proposta personalizada.
      </p>
      <div class="oferta-card__cta">
        <CtaButton block align="center" origin="oferta" />
      </div>
    </div>
  </div>
</section>

<style>
  .oferta {
    overflow: hidden;
  }
  .oferta__grid {
    display: grid;
    gap: 24px;
    align-items: center;
    padding-block: 64px;
  }
  @media (min-width: 1024px) {
    .oferta__grid {
      grid-template-columns: 0.85fr 1fr;
      gap: 40px;
      padding-block: 96px;
    }
  }

  /* R cerâmico TRANSPARENTE direto sobre o osso — sem palco/box escuro (pedido do Mateus).
     Sem drop-shadow (evita o flicker no reload); a profundidade vem do próprio render 3D +
     um respiro radial estático atrás. */
  .oferta__r {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }
  .oferta__r::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(48% 42% at 50% 52%, rgb(76 78 78 / 0.06), transparent 70%);
  }
  /* Mobile: esconde o R (opção A do Mateus) — composição R+card só faz sentido lado a lado. */
  @media (max-width: 1023.98px) {
    .oferta__r {
      display: none;
    }
  }
  .oferta__r-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
  }

  .oferta-card {
    position: relative;
    /* Site escuro (2026-07-24): o card sobe pra superfície MAIS CLARA que a faixa
       (era --surface-page, que agora é a base e deixaria o card mais escuro que o fundo). */
    background: var(--surface-soft);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 34px 24px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .oferta-card {
      padding: 48px 48px 44px;
    }
  }
  /* acento no topo do card — toque "desenhado" que casa com as etapas */
  .oferta-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--text-primary); /* segue a faixa: chumbo no claro, osso no escuro */
  }

  .oferta-card__title {
    margin-top: 4px;
  }
  .oferta-card__lead {
    margin-top: 12px;
    color: var(--text-secondary);
  }

  .oferta-card__label {
    margin-top: 28px;
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Checklist — círculo + check em CSS (sem lib de ícone), reforça "você recebe isto" */
  /* Extras: marcador "+" e texto secundário. Deliberadamente MENOS destacado que a lista de
     incluídos — é serviço que existe, não é promessa do que já está pago. */
  .oferta-extras {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .oferta-extras li {
    position: relative;
    padding-left: 32px;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-secondary);
  }
  .oferta-extras li::before {
    content: '+';
    position: absolute;
    left: 6px;
    top: 0;
    font-weight: 700;
    color: var(--text-muted);
  }

  .oferta-card__nota {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-secondary);
  }

  .oferta-checklist {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .oferta-checklist li {
    position: relative;
    padding-left: 32px;
    color: var(--text-primary);
  }
  .oferta-checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
  }
  .oferta-checklist li::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    width: 5px;
    height: 9px;
    border-right: 2px solid var(--text-primary);
    border-bottom: 2px solid var(--text-primary);
    transform: rotate(45deg);
  }


  /* 2026-07-24 (2ª decisão do Mateus, substitui a de horas antes): o botão VOLTA pro mobile.
     Regra nova da página — todo botão do desktop existe no mobile; quem se ajusta é a sticky
     bar, que agora só aparece quando nenhum botão está na tela (ver StickyCta.astro). */
  .oferta-card__cta {
    margin-top: 28px;
  }
</style>
