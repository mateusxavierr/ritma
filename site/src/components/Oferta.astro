---
/**
 * Oferta (redesign 2026-07-24 — composição do panfleto A6).
 * O H2 é a copy do panfleto; a papelaria traz o R cerâmico ao lado da oferta. Reproduz isso:
 * R cerâmico grande à esquerda (com um respiro radial atrás pra não sumir tom-sobre-tom no osso)
 * + card da oferta à direita, com a única sombra permitida da página (§2.3).
 * Faixa clara (osso) — mantém a alternância claro/escuro.
 */
import { Picture } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import rCeramico from '../assets/r-ceramico.png';
---

<section class="oferta bg-(--surface-alt)">
  <div class="container-page oferta__grid">
    <div class="oferta__r reveal" aria-hidden="true">
      <span class="oferta__r-halo"></span>
      <Picture
        src={rCeramico}
        alt=""
        formats={['avif', 'webp']}
        widths={[320, 480, 700, 900]}
        sizes="(min-width: 1024px) 420px, 60vw"
        class="oferta__r-img"
      />
    </div>

    <div class="oferta-card card-lift reveal" style="--reveal-delay:120ms">
      <h2 class="text-h2">Muito além de um processo burocrático</h2>
      <p class="mt-3 text-(--text-secondary)">
        Uma assessoria estratégica que assume a burocracia por você.
      </p>
      {/*
        [PENDENTE:SERVICOS] — escopo definicional abaixo; validar contra a lista real
        da agência quando chegar (PERGUNTAS-ABERTAS 1).
      */}
      <ul class="mt-8 grid gap-3">
        <li class="li-square">Consulta de viabilidade e análise de colidência</li>
        <li class="li-square">Definição de classes e estratégia de proteção</li>
        <li class="li-square">Preparação e protocolo do pedido no INPI</li>
        <li class="li-square">Acompanhamento do processo e aviso de cada despacho</li>
        <li class="li-square">Atendimento digital para todo o Brasil</li>
      </ul>
      <p class="mt-8 text-body-sm text-(--text-secondary)">
        Todo registro de marca envolve a taxa oficial do INPI, que parte de R$ 440 por classe para
        MEI, micro e pequenas empresas e pessoas físicas.
      </p>
      {/*
        Variante pós-liberação (§10.23), trocar o parágrafo acima por:
        `Registrar uma marca tem dois custos: a taxa oficial do INPI, que parte de R$ 440 por
        classe para MEI, micro e pequenas empresas e pessoas físicas, e os honorários da
        assessoria, que dependem do seu caso e são apresentados com clareza antes de qualquer
        contratação.`

        [PENDENTE:PRECO] — linha de preço/parcelamento entra aqui quando confirmada
        (PERGUNTAS-ABERTAS 2).

        [PENDENTE:GARANTIA] — linha de risk reversal entra aqui SÓ se a Amanda confirmar
        (PERGUNTAS-ABERTAS 3).
      */}
      <div class="mt-8">
        <CtaButton block align="center" origin="oferta" />
      </div>
    </div>
  </div>
</section>

<style>
  .oferta {
    overflow: hidden;
  }
  .oferta__grid {
    display: grid;
    gap: 24px;
    align-items: center;
    padding-block: 64px;
  }
  @media (min-width: 1024px) {
    .oferta__grid {
      grid-template-columns: 0.85fr 1fr;
      gap: 40px;
      padding-block: 96px;
    }
  }

  /* R cerâmico */
  .oferta__r {
    position: relative;
    display: flex;
    justify-content: center;
    isolation: isolate;
  }
  .oferta__r-img {
    position: relative;
    z-index: 1;
    display: block;
    width: min(240px, 55vw);
    height: auto;
    filter: drop-shadow(0 24px 40px rgb(76 78 78 / 0.22));
  }
  @media (min-width: 1024px) {
    .oferta__r-img {
      width: 100%;
      max-width: 420px;
      margin-left: -12px; /* leve bleed pra esquerda, como no panfleto */
    }
  }
  /* respiro radial atrás do R — separa do osso sem virar faixa escura */
  .oferta__r-halo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      52% 46% at 50% 52%,
      rgb(76 78 78 / 0.08),
      transparent 70%
    );
  }

  .oferta-card {
    background: var(--surface-page);
    border-radius: 18px;
    padding: 32px 24px;
  }
  @media (min-width: 768px) {
    .oferta-card {
      padding: 44px 48px;
    }
  }
</style>
