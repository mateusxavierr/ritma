---
/**
 * Oferta (redesign 2026-07-24 — composição do panfleto A6).
 * O H2 é a copy do panfleto; a papelaria traz o R cerâmico ao lado da oferta. Reproduz isso:
 * R cerâmico grande à esquerda (com um respiro radial atrás pra não sumir tom-sobre-tom no osso)
 * + card da oferta à direita, com a única sombra permitida da página (§2.3).
 * Faixa clara (osso) — mantém a alternância claro/escuro.
 */
import { Picture } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import rCeramico from '../assets/r-ceramico.png';

/* 2026-07-28 — reescrita pedida pelo Manolo ("deixar o serviço como benefício"). A seção
   prometia "muito além de um processo burocrático" e entregava 14 linhas de lista
   burocrática: ela desmentia o próprio título, e é a última antes do FAQ.
   Cada item agora lidera pelo GANHO dela; o nome do serviço fica como legenda — nada foi
   removido nem inventado, é a mesma lista que a Amanda confirmou em 2026-07-24. */
const incluidos = [
  {
    ganho: 'Você descobre se o nome está livre antes de gastar com ele',
    servico: 'Consulta de viabilidade e análise de colidência',
  },
  {
    ganho: 'Você entende o que está protegendo: o nome, o desenho ou os dois',
    servico: 'Orientação sobre marca nominativa, mista, figurativa ou tridimensional',
  },
  {
    ganho: 'A proteção cobre o ramo em que você atua, não um genérico',
    servico: 'Definição de classes e estratégia de proteção',
  },
  {
    ganho: 'Sua prioridade na fila começa a contar, e não é você quem preenche nada',
    servico: 'Preparação e protocolo do pedido no INPI',
  },
  {
    ganho: 'Você não precisa abrir o site do INPI nenhuma vez',
    servico: 'Acompanhamento do processo e aviso de cada despacho',
  },
  {
    ganho: 'A conversa acontece onde você já está',
    servico: 'Atendimento digital para todo o Brasil',
  },
];

/* Mesma lista de antes, outra leitura: era "o que NÃO está incluído" (paredão de upsell),
   vira "a Ritma continua com você depois do protocolo". O aviso de orçamento à parte
   permanece — a honestidade da linha é inegociável, o enquadramento é que muda. */
const continuidade = [
  'Resposta a exigências do INPI',
  'Defesa contra oposições e oposição a pedidos de terceiros',
  'Recursos administrativos',
  'Petições de retificação de dados',
  'Monitoramento de marcas semelhantes',
  'Renovação do registro, a cada 10 anos',
  'Averbação de alteração de nome, endereço ou razão social',
  'Transferência de titularidade (cessão de marca)',
];
---

<section class="oferta band-light">
  {/* 2026-07-28 — o card único ficou longo demais (pedido do Mateus: quebrar em 2-3).
      Vira três blocos com papéis distintos: entrega → argumento → continuidade + ação.
      O R permanece, com menos protagonismo: ele deixa de ser o contrapeso de um card
      gigante e passa a acompanhar só o primeiro bloco. */}
  <div class="container-page oferta__wrap">
    <div class="oferta__grid">
      <div class="oferta__r reveal" aria-hidden="true">
        <Picture
          src={rCeramico}
          alt=""
          formats={['avif', 'webp']}
          widths={[280, 420, 600, 780]}
          sizes="(min-width: 1024px) 300px, 55vw"
          class="oferta__r-img"
        />
      </div>

      {/* BLOCO 1 — o que a assessoria entrega, lido pelo ganho dela. */}
      <div class="oferta-card oferta-card--principal card-lift reveal" style="--reveal-delay:120ms">
        <h2 class="text-h2 oferta-card__title">Muito além de um processo burocrático</h2>
        <p class="oferta-card__lead">
          A burocracia é nossa. Do seu lado fica só a decisão: o que proteger, em qual ramo e até
          onde.
        </p>

        {/* Lista REAL confirmada pela Amanda em 2026-07-24 (fecha [PENDENTE:SERVICOS]). */}
        <p class="oferta-card__label">O que muda pra você</p>
        <ul class="oferta-checklist">
          {
            incluidos.map((item) => (
              <li>
                <strong>{item.ganho}</strong>
                <span>{item.servico}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* BLOCO 2 — a ideia nova da seção (2026-07-28): até aqui a página inteira trata o
        registro como processo. Este é o único lugar onde ele vira PATRIMÔNIO, e é o
        argumento que reposiciona o custo. Fato, não promessa: prazo e cessão são da
        Lei 9.279/96, e a cessão já constava da lista de serviços da Amanda.
        Fora do card, ele vira o respiro entre os dois blocos claros. */}
    <aside class="oferta-ativo reveal" style="--reveal-delay:80ms">
      <span class="oferta-ativo__textura" aria-hidden="true"></span>
      <p class="oferta-ativo__numero" aria-hidden="true">10<span>anos</span></p>
      <div class="oferta-ativo__texto">
        <p class="oferta-ativo__titulo">Registro não é taxa. É patrimônio.</p>
        <p class="oferta-ativo__corpo">
          O registro vale <strong>10 anos e é renovável para sempre</strong>. A partir dele a marca
          é um bem do seu negócio: pode ser licenciada, transferida ou vendida junto com ele.
        </p>
      </div>
    </aside>

    {/* BLOCO 3 — continuidade + honorários + ação. Serviços que a Amanda faz mas NÃO entram
        no plano básico; ela orça caso a caso ("é difícil alguém fechar um pacote que inclui
        tudo, porque sai mais caro"). Marcador é "+", nunca check: check ao lado de item não
        incluído é promessa falsa. */}
    <div class="oferta-card card-lift reveal" style="--reveal-delay:80ms">
      <p class="oferta-card__label oferta-card__label--topo">Depois do protocolo, a Ritma continua</p>
      <p class="oferta-extras__nota">Orçados à parte, conforme o que o seu caso pedir.</p>
      <ul class="oferta-extras">
        {continuidade.map((item) => <li>{item}</li>)}
      </ul>

      {/* Texto de honorários na formulação que a própria Amanda validou como OAB-safe:
          sem valor, sem "a partir de" (fecha [PENDENTE:PRECO] e [PENDENTE:GARANTIA] —
          não existe garantia; o que existe é orçamento por caso). */}
      <p class="oferta-card__nota">
        Os honorários são definidos de acordo com as particularidades de cada caso. Entre em
        contato para receber uma proposta personalizada.
      </p>
      <div class="oferta-card__cta">
        <CtaButton block align="center" origin="oferta" />
      </div>
    </div>
  </div>
</section>

<style>
  .oferta {
    overflow: hidden;
  }
  /* O padding vive no wrapper: os três blocos empilham dentro dele com o mesmo respiro. */
  .oferta__wrap {
    display: grid;
    gap: 16px;
    padding-block: 64px;
  }
  @media (min-width: 1024px) {
    .oferta__wrap {
      gap: 24px;
      padding-block: 96px;
    }
  }
  .oferta__grid {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .oferta__grid {
      /* Era 0.85fr 1fr, quando o R equilibrava um card único e altíssimo. Com o conteúdo
         repartido em três, a coluna do R encolhe: ele continua na composição, sem mandar. */
      grid-template-columns: 0.5fr 1fr;
      gap: 40px;
    }
  }

  /* R cerâmico TRANSPARENTE direto sobre o osso — sem palco/box escuro (pedido do Mateus).
     Sem drop-shadow (evita o flicker no reload); a profundidade vem do próprio render 3D +
     um respiro radial estático atrás. */
  .oferta__r {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }
  .oferta__r::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(48% 42% at 50% 52%, rgb(76 78 78 / 0.06), transparent 70%);
  }
  /* Mobile: esconde o R (opção A do Mateus) — composição R+card só faz sentido lado a lado. */
  @media (max-width: 1023.98px) {
    .oferta__r {
      display: none;
    }
  }
  .oferta__r-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    max-width: 300px; /* era 380px — protagonismo menor, presença mantida */
    height: auto;
  }

  .oferta-card {
    position: relative;
    /* Site escuro (2026-07-24): o card sobe pra superfície MAIS CLARA que a faixa
       (era --surface-page, que agora é a base e deixaria o card mais escuro que o fundo). */
    background: var(--surface-soft);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 32px 24px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .oferta-card {
      padding: 48px;
    }
  }
  /* Acento no topo só do card primário. Antes os dois traziam a barra e a mesma sombra,
     então liam com o mesmo peso — o de continuidade é material de apoio e precisa ceder o
     primeiro plano ao da entrega. Classe explícita, não :first-of-type: o primeiro filho
     do grid é a coluna do R, então o seletor posicional não pegava card nenhum. */
  .oferta-card--principal::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--text-primary); /* segue a faixa: chumbo no claro, osso no escuro */
  }

  .oferta-card__title {
    margin-top: 4px;
  }
  .oferta-card__lead {
    margin-top: 12px;
    max-width: 52ch; /* medida de leitura: o card chega a ~700px no desktop */
    color: var(--text-secondary);
  }

  .oferta-card__label {
    margin-top: 32px;
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary); /* era --text-muted: 4.46:1 sobre o card, reprova AA */
  }
  /* Quando o rótulo abre o card, ele não carrega o respiro de quem vinha depois de uma
     lista. Precisa vir DEPOIS da regra base: mesma especificidade, quem fica embaixo vence. */
  .oferta-card__label--topo {
    margin-top: 0;
  }

  /* Bloco de patrimônio: a "vida" que o Manolo pediu, feita com contraste em vez de cor
     nova. Inverte pro chumbo dentro de um card claro — é o único elemento invertido da
     seção, então ele para o olho sem competir com o botão (que segue sendo a única
     coisa colorida da página). */
  .oferta-ativo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 18px;
    background: var(--surface-inverse);
    padding: 24px;
    /* Bloco escuro erguido sobre a faixa clara: sem sombra ele lê como buraco, com
       sombra lê como peça apoiada. Sombra preta — a tingida no chumbo some aqui. */
    box-shadow:
      0 2px 4px rgb(20 21 21 / 0.16),
      0 18px 40px rgb(20 21 21 / 0.22);
  }
  /* Padrão de R oficial das diretrizes, em osso sobre o chumbo. É o mesmo asset das faixas
     escuras da página — aqui ele dá acabamento de papelaria ao único bloco invertido. */
  .oferta-ativo__textura {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: url('/ritma/pattern-r.svg') repeat;
    background-size: 260px auto;
    opacity: 0.05;
  }
  .oferta-ativo__numero,
  .oferta-ativo__texto {
    position: relative;
    z-index: 1;
  }

  /* Métrica grande + rótulo pequeno: o argumento do bloco é um número, e número merece
     virar âncora visual em vez de ficar diluído no meio da frase. */
  .oferta-ativo__numero {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: clamp(2.75rem, 2rem + 3vw, 4rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-on-inverse);
  }
  .oferta-ativo__numero span {
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* Osso direto, NÃO --text-on-dark-soft: dentro de .band-light aquele token é remapeado
       pra chumbo (global.css), e este bloco é uma ilha escura dentro da faixa clara. */
    color: color-mix(in srgb, var(--sand-100) 76%, transparent);
  }

  @media (min-width: 768px) {
    .oferta-ativo {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 40px;
      padding: 32px 48px;
    }
    /* Régua entre o número e o texto: separa os dois papéis sem precisar de caixa. */
    .oferta-ativo__texto {
      border-left: 1px solid color-mix(in srgb, var(--sand-100) 22%, transparent);
      padding-left: 40px;
    }
  }

  .oferta-ativo__titulo {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: 700;
    color: var(--text-on-inverse);
  }
  .oferta-ativo__corpo {
    margin-top: 8px;
    max-width: 62ch;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-on-inverse-2);
  }
  .oferta-ativo__corpo strong {
    font-weight: 700;
    color: var(--text-on-inverse);
  }
  @media (max-width: 767.98px) {
    .oferta-ativo__texto {
      margin-top: 20px;
    }
  }

  /* Checklist — círculo + check em CSS (sem lib de ícone), reforça "você recebe isto" */
  /* Extras: marcador "+" e texto secundário. Deliberadamente MENOS destacado que a lista de
     incluídos — é serviço que existe, não é promessa do que já está pago. */
  .oferta-extras__nota {
    margin-top: 4px;
    font-size: var(--text-caption);
    line-height: 1.45;
    color: var(--text-secondary);
  }
  .oferta-extras {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  /* Duas colunas a partir do desktop: 8 itens em coluna única viravam um paredão que
     lia como "o que você vai pagar a mais". */
  @media (min-width: 768px) {
    .oferta-extras {
      grid-template-columns: 1fr 1fr;
      column-gap: 24px;
    }
  }
  .oferta-extras li {
    position: relative;
    padding-left: 32px;
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-secondary);
  }
  .oferta-extras li::before {
    content: '+';
    position: absolute;
    left: 6px;
    top: 0;
    font-weight: 700;
    color: var(--text-secondary); /* mesmo motivo do rótulo: 4.46:1 não passa */
  }

  .oferta-card__nota {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-secondary);
  }

  .oferta-checklist {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  /* O ganho lidera em corpo cheio; o nome do serviço vira legenda logo abaixo. Assim a
     lista para de ser ficha técnica sem perder o que de fato está sendo entregue. */
  .oferta-checklist li {
    position: relative;
    padding-left: 32px;
    color: var(--text-primary);
  }
  .oferta-checklist li strong {
    display: block;
    font-weight: 600;
  }
  .oferta-checklist li span {
    display: block;
    margin-top: 2px;
    font-size: var(--text-caption);
    line-height: 1.45;
    color: var(--text-secondary);
  }
  .oferta-checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
  }
  .oferta-checklist li::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    width: 5px;
    height: 9px;
    border-right: 2px solid var(--text-primary);
    border-bottom: 2px solid var(--text-primary);
    transform: rotate(45deg);
  }


  /* 2026-07-24 (2ª decisão do Mateus, substitui a de horas antes): o botão VOLTA pro mobile.
     Regra nova da página — todo botão do desktop existe no mobile; quem se ajusta é a sticky
     bar, que agora só aparece quando nenhum botão está na tela (ver StickyCta.astro). */
  /* No mobile o botão avança sobre o padding do card. Uma linha só de rótulo é o pedido,
     e cada pixel de largura vira fonte: sem isso a fonte cairia a 11,8px aos 360px. */
  @media (max-width: 767.98px) {
    .oferta-card__cta {
      margin-inline: -12px;
    }
  }
  .oferta-card__cta {
    margin-top: 32px;
  }
</style>
