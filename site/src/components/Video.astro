---
/**
 * Seção 2 — vídeo (pedido do Mateus, 2026-07-24; estrutura de referência: hero → vídeo → ...).
 * Título acima, vídeo no meio, CTA abaixo. Fundo com a marca d'água de R (padrão oficial).
 *
 * VÍDEO NO PRÓPRIO SITE (2026-08-07). Saiu o YouTube, entrou <video> nativo.
 *
 * Por quê: o vídeo da Amanda é vertical de 1:17 e o YouTube classifica isso como Short. Pra
 * Short ele serve um player que IGNORA controls=0 e desenha por cima o título, o nome do canal
 * e o logo. Testei seis combinações de parâmetro (host normal e nocookie, loop+playlist,
 * autoplay+mute, widget_referrer, videoseries) e a flag `isShortsExperienceEligible` continuou
 * em todas — ela vem da classificação do vídeo no catálogo, não de parâmetro nosso. Não existe
 * chave pra desligar do lado de fora. Servindo o arquivo daqui, o problema deixa de existir.
 *
 * O ARQUIVO: master de 163 MB (2160×3840, HEVC, 60fps) reencodado pra 1080×1920 a 30fps,
 * H.264 CRF 28 = 13,7 MB a 1,5 Mbps, com +faststart pra tocar durante o download. Comparado
 * quadro a quadro com o master no recorte da legenda queimada: indistinguível. O material tem
 * bastante b-roll (shopping, loja, plano de cidade), que comprime pior que plano fixo — por
 * isso 13,7 MB e não os 8 que a estimativa inicial supunha.
 *
 * CUSTO ACEITO: sem bitrate adaptativo. Quem está em conexão ruim espera mais, em vez de
 * receber 360p automático. Atenuado pelo download progressivo (o play começa com alguns
 * segundos de buffer) e por preload="none" (quem não chega na seção não baixa nada).
 *
 * PLAY AUTOMÁTICO NO SCROLL (pedido do Manolo via Mateus): nada é baixado antes de a seção
 * entrar na tela. Ao sair, pausa. Autoplay em navegador só roda MUDO (regra do Chrome/Safari,
 * não escolha nossa), e por isso existe o botão "Ativar som".
 *
 * SEM JS o <video> nasce com `controls` nativo e o script tira o atributo ao assumir. Assim
 * quem tem JS desligado assiste com os controles do navegador em vez de olhar um retângulo
 * morto — antes essa gente ia parar num link pro YouTube.
 *
 * O palco é retrato porque o material é 9:16 com legenda queimada no terço inferior; cortar
 * pra caber num quadro deitado comeria a legenda, que é o que carrega a mensagem no mudo.
 */
import CtaButton from './CtaButton.astro';

const MP4 = `${import.meta.env.BASE_URL}video/amanda.mp4`;
const POSTER = `${import.meta.env.BASE_URL}video/amanda-poster.webp`;
---

<section class="video band-light">
  {/* Textura de R repetidos — veio do hero (pedido do Mateus). Única textura desta seção:
      o glifo R gigante saiu daqui em 2026-07-24 e foi pro "Como funciona". */}
  <span class="texture-r-ink" aria-hidden="true"></span>
  <div class="container-page py-16 md:py-24">
    <h2 class="text-h2 video__title reveal">
      Antes de investir mais na sua marca, entenda se ela <strong>está protegida</strong>.
    </h2>

    {/* PALCO ESCURO (2026-07-24 — ideia do Manolo: escuro em volta do vídeo dá foco).
        O escuro abraça o player em vez de tomar a seção inteira: assim a alternância
        escuro/claro da página continua de pé E o contraste ao redor do vídeo fica MAIOR,
        porque a faixa em volta é clara. */}
    <div class="video__frame band-dark reveal" style="--reveal-delay:120ms" data-video-stage>
      <div class="video__palco">
        {/* controls sai no JS. preload="none": zero byte até alguém chegar aqui. */}
        <video
          class="video__midia"
          data-video-midia
          poster={POSTER}
          preload="none"
          playsinline
          muted
          loop
          controls
        >
          <source src={MP4} type="video/mp4" />
        </video>
      </div>

      {/* Botão central: estado de espera antes do primeiro play e de pausa depois. */}
      <button class="video__grande" data-video-grande aria-label="Reproduzir vídeo" hidden>
        <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </button>

      {/* Chamada pra ligar o som: o autoplay é obrigatoriamente mudo, então sem isto o
          visitante assiste inteiro sem áudio achando que o vídeo é só legendado. */}
      <button class="video__som-dica" data-video-som-dica hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"></path>
          <path
            d="M17 10l4 4m0-4l-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
        Ativar som
      </button>

      <div class="video__barra" data-video-barra hidden>
        <button class="video__bt" data-video-play aria-label="Reproduzir">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path data-video-play-glifo d="M8 5v14l11-7z"></path>
          </svg>
        </button>

        <div
          class="video__trilha"
          data-video-trilha
          role="slider"
          tabindex="0"
          aria-label="Progresso do vídeo"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-valuetext="0 por cento"
        >
          <span class="video__trilha-fundo" aria-hidden="true"></span>
          <span class="video__trilha-cheia" data-video-progresso aria-hidden="true"></span>
          <span class="video__trilha-bola" data-video-bola aria-hidden="true"></span>
        </div>

        <span class="video__tempo" data-video-tempo aria-hidden="true">0:00</span>

        <button class="video__bt" data-video-som aria-label="Ativar som">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"></path>
            {/* Os dois estados moram no mesmo SVG e quem troca é a classe do frame, não o
                atributo hidden: em <g> de SVG o hidden não é confiável entre navegadores. */}
            <g class="video__glifo-mudo">
              <path
                d="M17 10l4 4m0-4l-4 4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </g>
            <g class="video__glifo-alto">
              <path
                d="M16.4 8.8a4.5 4.5 0 0 1 0 6.4M19 6.2a8 8 0 0 1 0 11.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </g>
          </svg>
        </button>

        <button class="video__bt" data-video-tela aria-label="Tela cheia">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path
              d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="video__cta reveal" style="--reveal-delay:180ms">
      <CtaButton align="center" origin="video" />
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var frame = document.querySelector('[data-video-stage]');
    if (!frame) return;

    var video = frame.querySelector('[data-video-midia]');
    var btGrande = frame.querySelector('[data-video-grande]');
    var somDica = frame.querySelector('[data-video-som-dica]');
    var barra = frame.querySelector('[data-video-barra]');
    var btPlay = frame.querySelector('[data-video-play]');
    var playGlifo = frame.querySelector('[data-video-play-glifo]');
    var trilha = frame.querySelector('[data-video-trilha]');
    var progresso = frame.querySelector('[data-video-progresso]');
    var bola = frame.querySelector('[data-video-bola]');
    var tempoTexto = frame.querySelector('[data-video-tempo]');
    var btSom = frame.querySelector('[data-video-som]');
    var btTela = frame.querySelector('[data-video-tela]');

    /* Assumimos o controle: fora os nativos, dentro os nossos. Nessa ordem, pra nunca existir
       um instante com dois conjuntos de controle na tela nem um sem nenhum. */
    video.removeAttribute('controls');
    barra.hidden = false;
    btGrande.hidden = false;

    var reduzirMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var arrastando = false;
    var sumico = null;

    var GLIFO_PLAY = 'M8 5v14l11-7z';
    var GLIFO_PAUSE = 'M7 5h3.5v14H7zM13.5 5H17v14h-3.5z';

    function tocando() {
      return !video.paused && !video.ended;
    }

    function relogioTexto(s) {
      s = Math.max(0, Math.floor(s || 0));
      var m = Math.floor(s / 60);
      var r = s % 60;
      return m + ':' + (r < 10 ? '0' : '') + r;
    }

    /* "0:12 / 1:17". A duração entra só quando os metadados chegam — antes disso seria
       "0:00 / 0:00", que passa impressão de player quebrado. */
    function escreverTempo(agora) {
      var d = isFinite(video.duration) ? video.duration : 0;
      tempoTexto.textContent = d
        ? relogioTexto(agora) + ' / ' + relogioTexto(d)
        : relogioTexto(agora);
    }

    function pintar(pct) {
      pct = Math.min(100, Math.max(0, pct));
      progresso.style.width = pct + '%';
      bola.style.left = pct + '%';
      trilha.setAttribute('aria-valuenow', Math.round(pct));
      trilha.setAttribute('aria-valuetext', Math.round(pct) + ' por cento');
    }

    function atualizar() {
      if (arrastando) return;
      var d = isFinite(video.duration) ? video.duration : 0;
      pintar(d ? (video.currentTime / d) * 100 : 0);
      escreverTempo(video.currentTime);
    }

    /* ——— Barra que aparece e some ———
       Some só enquanto TOCA. Pausado, ela fica: player parado sem controle visível é player
       quebrado aos olhos de quem chegou agora. */
    function mostrarBarra(fixar) {
      frame.classList.add('mostra-controles');
      if (sumico) clearTimeout(sumico);
      if (!fixar) esconderBarraDepois();
    }
    function esconderBarraDepois() {
      if (sumico) clearTimeout(sumico);
      sumico = setTimeout(function () {
        if (tocando() && !arrastando) frame.classList.remove('mostra-controles');
      }, 2600);
    }

    /* Um só lugar decide a cara dos controles, e ele lê o estado REAL do <video> em vez de
       supor. Os eventos play/pause chamam isto, e o play recusado também. */
    function sincronizar() {
      var t = tocando();
      frame.classList.toggle('is-playing', t);
      playGlifo.setAttribute('d', t ? GLIFO_PAUSE : GLIFO_PLAY);
      btPlay.setAttribute('aria-label', t ? 'Pausar' : 'Reproduzir');
      btGrande.hidden = t;
      somDica.hidden = !(t && video.muted);
    }

    /* play() devolve promessa e ela PODE ser recusada — autoplay bloqueado, aba em segundo
       plano, modo de baixo consumo. Quando isso acontece o navegador nem sempre dispara
       'pause', e sem este catch a barra fica mostrando "pausar" em cima de um vídeo parado.
       Apareceu no teste, não é hipótese. */
    function tocar() {
      var p = video.play();
      if (p && p.catch) p.catch(sincronizar);
    }

    function alternar() {
      if (tocando()) video.pause();
      else tocar();
      mostrarBarra();
    }

    /* No corpo do vídeo, o primeiro toque só ACENDE os controles; quem pausa é o segundo.
       No celular a barra fica escondida enquanto roda, e sem essa regra o toque de "deixa eu
       ver quanto falta" pausa o vídeo na cara do visitante. Botão central e botão da barra
       seguem pausando de primeira, porque ali a intenção é explícita. */
    video.addEventListener('click', function () {
      if (tocando() && !frame.classList.contains('mostra-controles')) {
        mostrarBarra();
        return;
      }
      alternar();
    });
    btGrande.addEventListener('click', alternar);
    btPlay.addEventListener('click', alternar);

    video.addEventListener('play', function () {
      sincronizar();
      esconderBarraDepois();
    });
    video.addEventListener('pause', function () {
      sincronizar();
      mostrarBarra(true);
    });
    video.addEventListener('timeupdate', atualizar);
    video.addEventListener('loadedmetadata', atualizar);
    video.addEventListener('durationchange', atualizar);

    function alternarSom() {
      video.muted = !video.muted;
      if (!video.muted) video.volume = 1;
      frame.classList.toggle('com-som', !video.muted);
      btSom.setAttribute('aria-label', video.muted ? 'Ativar som' : 'Desativar som');
      somDica.hidden = !(video.muted && tocando());
      mostrarBarra();
    }
    btSom.addEventListener('click', alternarSom);
    somDica.addEventListener('click', alternarSom);

    /* Tela cheia: no iPhone o Safari não põe elemento comum em tela cheia, só o próprio
       <video> — e aí quem aparece é o player do sistema, com os controles dele. É limitação
       do iOS, não escolha; nos outros lugares vai o palco inteiro e os controles são nossos. */
    btTela.addEventListener('click', function () {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else if (frame.requestFullscreen) {
        frame.requestFullscreen();
      } else if (video.webkitEnterFullscreen) {
        video.webkitEnterFullscreen();
      }
    });
    document.addEventListener('fullscreenchange', function () {
      var cheia = document.fullscreenElement === frame;
      btTela.setAttribute('aria-label', cheia ? 'Sair da tela cheia' : 'Tela cheia');
      mostrarBarra();
    });

    /* Arraste na trilha: pointer events cobrem mouse, toque e caneta com um caminho só.
       setPointerCapture mantém o arraste vivo mesmo se o dedo sair da barra. */
    function posicao(e) {
      var r = trilha.getBoundingClientRect();
      return Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    }
    function buscar(e, soltar) {
      var d = isFinite(video.duration) ? video.duration : 0;
      if (!d) return;
      var f = posicao(e);
      pintar(f * 100);
      escreverTempo(f * d);
      if (soltar) video.currentTime = f * d;
    }
    trilha.addEventListener('pointerdown', function (e) {
      arrastando = true;
      trilha.setPointerCapture(e.pointerId);
      buscar(e, false);
      mostrarBarra(true);
    });
    trilha.addEventListener('pointermove', function (e) {
      if (arrastando) buscar(e, false);
    });
    trilha.addEventListener('pointerup', function (e) {
      if (!arrastando) return;
      arrastando = false;
      buscar(e, true);
      esconderBarraDepois();
    });
    trilha.addEventListener('keydown', function (e) {
      var d = isFinite(video.duration) ? video.duration : 0;
      if (!d) return;
      var destino = null;
      if (e.key === 'ArrowRight') destino = video.currentTime + 5;
      else if (e.key === 'ArrowLeft') destino = video.currentTime - 5;
      else if (e.key === 'Home') destino = 0;
      else if (e.key === 'End') destino = d;
      else if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        alternar();
        return;
      }
      if (destino === null) return;
      e.preventDefault();
      video.currentTime = Math.min(d, Math.max(0, destino));
      atualizar();
      mostrarBarra();
    });

    frame.addEventListener('pointermove', function () {
      mostrarBarra();
    });
    frame.addEventListener('pointerleave', function () {
      if (tocando() && !arrastando) frame.classList.remove('mostra-controles');
    });
    frame.addEventListener('focusin', function () {
      mostrarBarra(true);
    });

    mostrarBarra(true);

    // Com movimento reduzido nada toca sozinho: quem manda é o botão.
    if (reduzirMovimento || !('IntersectionObserver' in window)) return;

    /* ——— MODO CINEMA (ideia do Mateus, 2026-07-24) ———
       Depois de ~3,5s com a seção enquadrada, a página toda escurece por baixo de um véu e
       ficam acesos só o título, o vídeo e o botão. O título clareia junto (chumbo → osso),
       senão sumiria no escuro. Sai no instante em que a seção deixa a tela.
       Regras que eu não abri mão: o véu NÃO captura clique (pointer-events:none), então nada
       trava a rolagem; o BOTÃO continua aceso e clicável — apagar a conversão pra fazer efeito
       seria trocar venda por firula. */
    var veu = null;
    var tempoCinema = null;

    function cinema(ligar) {
      if (!ligar) {
        document.documentElement.classList.remove('cinema-on');
        return;
      }
      if (veu) {
        // Segunda visita à seção: o véu já existe, só reacende.
        document.documentElement.classList.add('cinema-on');
        return;
      }
      veu = document.createElement('div');
      veu.className = 'video__veu';
      document.body.appendChild(veu);
      // Um respiro antes de ligar a classe, senão o opacity entra sem animar.
      // (setTimeout e não requestAnimationFrame: rAF não roda em aba de fundo, e aí o véu
      // ficava criado porém invisível — foi o que apareceu no teste.)
      setTimeout(function () {
        document.documentElement.classList.add('cinema-on');
      }, 20);
    }

    // Pausa por SAÍDA DE TELA e pausa por clique são coisas diferentes: se o visitante pausou
    // na mão, voltar à seção não pode religar o vídeo por cima da vontade dele.
    var pausadoNaMao = false;
    btGrande.addEventListener('click', marcarManual);
    btPlay.addEventListener('click', marcarManual);
    video.addEventListener('click', marcarManual);
    function marcarManual() {
      pausadoNaMao = !tocando();
    }

    new IntersectionObserver(
      function (entradas) {
        var visivel = entradas[entradas.length - 1].isIntersecting;
        if (visivel) {
          if (!pausadoNaMao) tocar();
        } else if (tocando()) {
          video.pause();
          pausadoNaMao = false;
        }

        clearTimeout(tempoCinema);
        if (visivel)
          tempoCinema = setTimeout(function () {
            cinema(true);
          }, 3500);
        else cinema(false);
      },
      // 40%: começa assim que a seção está de fato enquadrada. Acima disso, em tela baixa
      // (notebook 13"), o palco às vezes nunca atingia o limiar e o vídeo não engatava.
      { threshold: 0.4 }
    ).observe(frame);
  })();
</script>

<style>
  .video {
    overflow: hidden;
  }

  .video__title {
    max-width: 22ch;
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
    transition: color 700ms ease;
  }
  /* Duas linhas no desktop (pedido do Mateus, 2026-08-06), quebrando na vírgula:
     "Antes de investir mais na sua marca," / "entenda se ela está protegida."
     O balance vira 2 linhas a partir de 26ch — 28ch é folga proposital, porque em cima do
     limiar qualquer diferença de métrica na carga da fonte joga de volta pra 3 linhas.
     Em ch, não em px: a medida acompanha o clamp do --text-h2 e a quebra é a mesma em
     qualquer largura daqui pra cima. No mobile continua 22ch (3 linhas equilibradas). */
  @media (min-width: 768px) {
    .video__title {
      max-width: 28ch;
    }
  }

  /* ——— MODO CINEMA ———
     O véu é fixo, cobre tudo (inclusive o header) e NÃO recebe clique. Fica abaixo da sticky
     bar (z-40) e acima do header (z-30). Os três elementos acesos sobem pra 36. */
  :global(.video__veu) {
    position: fixed;
    inset: 0;
    z-index: 35;
    pointer-events: none;
    background: rgb(18 19 19 / 0.88);
    opacity: 0;
    transition: opacity 900ms ease;
  }
  :global(.cinema-on) .video__veu,
  :global(.cinema-on) :global(.video__veu) {
    opacity: 1;
  }
  /* .band-light cria contexto de empilhamento (isolation: isolate) — dentro dele, z-index 36
     não alcança o véu, que vive na raiz. Sem isto, o "holofote" vira só "tudo escurece":
     foi exatamente o que apareceu no primeiro teste. No modo cinema a seção abre mão do
     isolamento e os quatro elementos sobem de verdade. */
  :global(.cinema-on) .video {
    isolation: auto;
  }
  :global(.cinema-on) .video__title,
  :global(.cinema-on) .video__frame,
  :global(.cinema-on) .video__cta {
    position: relative;
    z-index: 36;
  }
  /* O título vira osso: no escuro, chumbo sobre véu não se lê. */
  :global(.cinema-on) .video__title,
  :global(.cinema-on) .video__title strong {
    color: var(--sand-100);
  }
  /* Com tudo escuro em volta, o botão ganha o mesmo contorno que usa nas faixas escuras. */
  :global(.cinema-on) .video__cta :global(.cta) {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--petrol-200) 42%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.video__veu) {
      transition: none;
    }
  }
  /* O negrito aqui é hierarquia dentro do H2, que já é 700: sobe pro 800 e escurece o tom.
     Peso sozinho não separaria o suficiente de um título que já é pesado. */
  .video__title strong {
    font-weight: 800;
    color: var(--text-primary);
  }

  /* Palco 9:16 — o formato vem do material da Amanda, não de gosto. A largura é o menor de
     três limites, e cada um resolve um contexto: 380px trava o exagero em monitor grande;
     88vw dá a margem lateral no celular; 42vh impede que o retrato passe da altura da tela
     em notebook baixo (largura = altura × 9/16, então 42vh ≈ 75vh de altura). Uma linha só,
     sem media query. */
  .video__frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 32px auto 0;
    width: min(380px, 88vw, 42vh);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 0;
    border-radius: 20px;
    box-shadow:
      0 2px 6px rgb(46 48 48 / 0.14),
      0 24px 60px rgb(46 48 48 / 0.22);
    transition:
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 600ms ease;
  }
  /* "Apagar as luzes" (foco no vídeo): quando começa a tocar, o palco cresce 1,5% e a sombra
     aprofunda. Só isso — nada de escurecer texto ou botão em volta, que é onde a conversão
     mora. O contraste já vem do palco escuro contra a faixa clara. */
  .video__frame.is-playing {
    transform: scale(1.015);
    box-shadow:
      0 4px 10px rgb(46 48 48 / 0.18),
      0 34px 80px rgb(46 48 48 / 0.3);
  }
  @media (prefers-reduced-motion: reduce) {
    .video__frame.is-playing {
      transform: none;
    }
  }
