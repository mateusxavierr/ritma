---
/**
 * Seção 2 — vídeo (pedido do Mateus, 2026-07-24; estrutura de referência: hero → vídeo → ...).
 * Título acima, vídeo no meio, CTA abaixo. Fundo com a marca d'água de R (padrão oficial).
 *
 * PLAY AUTOMÁTICO NO SCROLL (pedido do Manolo via Mateus): o iframe só é criado quando a
 * seção entra na tela — antes disso não existe request nenhum pro YouTube. Ao sair da tela,
 * pausa. Autoplay em navegador só roda MUDO (regra do Chrome/Safari, não escolha nossa);
 * o som fica a um clique, nos controles do próprio player.
 *
 * VÍDEO DA AMANDA (entrou 2026-08-06, PERGUNTAS-ABERTAS C): é VERTICAL 9:16 (1080×1920,
 * publicado como Short) com legenda queimada no terço inferior. O palco era 16:9 e virou
 * retrato por causa disso — num quadro 16:9 o YouTube tarjaria as duas laterais e a Amanda
 * ficaria num filete central. Cortar não é opção: comeria a legenda queimada, que é o que
 * carrega a mensagem enquanto o autoplay roda mudo.
 */
import CtaButton from './CtaButton.astro';

const YT_ID = 'QJb9fCU5QuA';
---

<section class="video band-light">
  {/* Textura de R repetidos — veio do hero (pedido do Mateus). Única textura desta seção:
      o glifo R gigante saiu daqui em 2026-07-24 e foi pro "Como funciona". */}
  <span class="texture-r-ink" aria-hidden="true"></span>
  <div class="container-page py-16 md:py-24">
    <h2 class="text-h2 video__title reveal">
      Antes de investir mais na sua marca, entenda se ela <strong>está protegida</strong>.
    </h2>

    {/* PALCO ESCURO (2026-07-24 — ideia do Manolo: escuro em volta do vídeo dá foco).
        O escuro abraça o player em vez de tomar a seção inteira: assim a alternância
        escuro/claro da página continua de pé E o contraste ao redor do vídeo fica MAIOR,
        porque a faixa em volta é clara. */}
    <div
      class="video__frame band-dark reveal"
      style="--reveal-delay:120ms"
      data-yt={YT_ID}
      data-video-stage
    >
      {/* Estado de espera: some no instante em que o iframe entra. Sem JS, fica o botão. */}
      <span class="video__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </span>
      <noscript>
        <a class="video__fallback" href={`https://www.youtube.com/watch?v=${YT_ID}`} rel="noopener">
          Assistir ao vídeo
        </a>
      </noscript>
    </div>

    <div class="video__cta reveal" style="--reveal-delay:180ms">
      <CtaButton align="center" origin="video" />
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var palco = document.querySelector('[data-video-stage]');
    if (!palco || !('IntersectionObserver' in window)) return;

    var id = palco.getAttribute('data-yt');
    var reduzirMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var iframe = null;

    // O parâmetro autoplay=1 sozinho NÃO é confiável: o player carrega e fica em
    // playerState -1 (unstarted). O que funciona é mandar mute+playVideo pela API assim que
    // ele avisa onReady — e repetir uma vez, porque a primeira chamada às vezes chega antes
    // de o player estar pronto pra obedecer.
    function ouvirPlayer() {
      window.addEventListener('message', function (e) {
        if (!iframe || e.source !== iframe.contentWindow) return;
        var dado;
        try {
          dado = JSON.parse(e.data);
        } catch (err) {
          return;
        }
        if (dado.event === 'onReady') {
          comando('mute');
          comando('playVideo');
          setTimeout(function () {
            comando('playVideo');
          }, 900);
        }
      });
    }

    function criarIframe(autoplay) {
      iframe = document.createElement('iframe');
      // youtube-nocookie: sem cookie de tracking enquanto ninguém der play de verdade.
      iframe.src =
        'https://www.youtube-nocookie.com/embed/' +
        id +
        '?enablejsapi=1&rel=0&modestbranding=1&playsinline=1&loop=1&playlist=' +
        id +
        (autoplay ? '&autoplay=1&mute=1' : '');
      iframe.title = 'Vídeo de apresentação da Ritma Registros';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'video__iframe';
      palco.appendChild(iframe);
      palco.classList.add('is-playing');
      ouvirPlayer();
      // Handshake: sem isto o player não emite onReady nem os eventos de estado.
      var handshake = setInterval(function () {
        if (!iframe || !iframe.contentWindow) return;
        iframe.contentWindow.postMessage(
          JSON.stringify({ event: 'listening', id: 1, channel: 'widget' }),
          '*'
        );
      }, 300);
      setTimeout(function () {
        clearInterval(handshake);
      }, 4000);
    }

    // Comanda o player já criado (pausar ao sair da tela, voltar ao entrar).
    function comando(func) {
      if (!iframe || !iframe.contentWindow) return;
      iframe.contentWindow.postMessage(
        JSON.stringify({ event: 'command', func: func, args: [] }),
        '*'
      );
    }

    // Sem JS o iframe nem nasce; com movimento reduzido, nasce só no clique.
    if (reduzirMovimento) {
      palco.addEventListener('click', function () {
        if (!iframe) criarIframe(true);
      });
      palco.style.cursor = 'pointer';
      return;
    }

    /* ——— MODO CINEMA (ideia do Mateus, 2026-07-24) ———
       Depois de ~3,5s com a seção enquadrada, a página toda escurece por baixo de um véu e
       ficam acesos só o título, o vídeo e o botão. O título clareia junto (chumbo → osso),
       senão sumiria no escuro. Sai no instante em que a seção deixa a tela.
       Regras que eu não abri mão: o véu NÃO captura clique (pointer-events:none), então nada
       trava a rolagem; o BOTÃO continua aceso e clicável — apagar a conversão pra fazer efeito
       seria trocar venda por firula. */
    var veu = null;
    var tempoCinema = null;

    function cinema(ligar) {
      if (!ligar) {
        document.documentElement.classList.remove('cinema-on');
        return;
      }
      if (veu) {
        // Segunda visita à seção: o véu já existe, só reacende.
        document.documentElement.classList.add('cinema-on');
        return;
      }
      veu = document.createElement('div');
      veu.className = 'video__veu';
      document.body.appendChild(veu);
      // Um respiro antes de ligar a classe, senão o opacity entra sem animar.
      // (setTimeout e não requestAnimationFrame: rAF não roda em aba de fundo, e aí o véu
      // ficava criado porém invisível — foi o que apareceu no teste.)
      setTimeout(function () {
        document.documentElement.classList.add('cinema-on');
      }, 20);
    }

    new IntersectionObserver(
      function (entradas) {
        var visivel = entradas[entradas.length - 1].isIntersecting;
        if (visivel && !iframe) criarIframe(true);
        else if (iframe) comando(visivel ? 'playVideo' : 'pauseVideo');
        palco.classList.toggle('is-playing', visivel && !!iframe);

        clearTimeout(tempoCinema);
        if (visivel) tempoCinema = setTimeout(function () { cinema(true); }, 3500);
        else cinema(false);
      },
      // 40%: começa assim que a seção está de fato enquadrada. Acima disso, em tela baixa
      // (notebook 13"), o palco às vezes nunca atingia o limiar e o vídeo não engatava.
      { threshold: 0.4 }
    ).observe(palco);
  })();
</script>

<style>
  .video {
    overflow: hidden;
  }

  .video__title {
    max-width: 22ch;
    margin-inline: auto;
    text-align: center;
    text-wrap: balance;
    transition: color 700ms ease;
  }
  /* Duas linhas no desktop (pedido do Mateus, 2026-08-06), quebrando na vírgula:
     "Antes de investir mais na sua marca," / "entenda se ela está protegida."
     O balance vira 2 linhas a partir de 26ch — 28ch é folga proposital, porque em cima do
     limiar qualquer diferença de métrica na carga da fonte joga de volta pra 3 linhas.
     Em ch, não em px: a medida acompanha o clamp do --text-h2 e a quebra é a mesma em
     qualquer largura daqui pra cima. No mobile continua 22ch (3 linhas equilibradas). */
  @media (min-width: 768px) {
    .video__title {
      max-width: 28ch;
    }
  }

  /* ——— MODO CINEMA ———
     O véu é fixo, cobre tudo (inclusive o header) e NÃO recebe clique. Fica abaixo da sticky
     bar (z-40) e acima do header (z-30). Os três elementos acesos sobem pra 36. */
  :global(.video__veu) {
    position: fixed;
    inset: 0;
    z-index: 35;
    pointer-events: none;
    background: rgb(18 19 19 / 0.88);
    opacity: 0;
    transition: opacity 900ms ease;
  }
  :global(.cinema-on) .video__veu,
  :global(.cinema-on) :global(.video__veu) {
    opacity: 1;
  }
  /* .band-light cria contexto de empilhamento (isolation: isolate) — dentro dele, z-index 36
     não alcança o véu, que vive na raiz. Sem isto, o "holofote" vira só "tudo escurece":
     foi exatamente o que apareceu no primeiro teste. No modo cinema a seção abre mão do
     isolamento e os quatro elementos sobem de verdade. */
  :global(.cinema-on) .video {
    isolation: auto;
  }
  :global(.cinema-on) .video__title,
  :global(.cinema-on) .video__frame,
  :global(.cinema-on) .video__cta {
    position: relative;
    z-index: 36;
  }
  /* O título vira osso: no escuro, chumbo sobre véu não se lê. */
  :global(.cinema-on) .video__title,
  :global(.cinema-on) .video__title strong {
    color: var(--sand-100);
  }
  /* Com tudo escuro em volta, o botão ganha o mesmo contorno que usa nas faixas escuras. */
  :global(.cinema-on) .video__cta :global(.cta) {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--petrol-200) 42%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.video__veu) {
      transition: none;
    }
  }
  /* O negrito aqui é hierarquia dentro do H2, que já é 700: sobe pro 800 e escurece o tom.
     Peso sozinho não separaria o suficiente de um título que já é pesado. */
  .video__title strong {
    font-weight: 800;
    color: var(--text-primary);
  }

  /* Palco 9:16 — o formato vem do material da Amanda, não de gosto. A largura é o menor de
     três limites, e cada um resolve um contexto: 380px trava o exagero em monitor grande;
     88vw dá a margem lateral no celular; 42vh impede que o retrato passe da altura da tela
     em notebook baixo (largura = altura × 9/16, então 42vh ≈ 75vh de altura). Uma linha só,
     sem media query. */
  .video__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 32px auto 0;
    width: min(380px, 88vw, 42vh);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 0;
    border-radius: 20px;
    box-shadow:
      0 2px 6px rgb(46 48 48 / 0.14),
      0 24px 60px rgb(46 48 48 / 0.22);
    transition:
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 600ms ease;
  }
  /* "Apagar as luzes" (foco no vídeo): quando começa a tocar, o palco cresce 1,5% e a sombra
     aprofunda. Só isso — nada de escurecer texto ou botão em volta, que é onde a conversão
     mora. O contraste já vem do palco escuro contra a faixa clara. */
  .video__frame.is-playing {
    transform: scale(1.015);
    box-shadow:
      0 4px 10px rgb(46 48 48 / 0.18),
      0 34px 80px rgb(46 48 48 / 0.3);
  }
  @media (prefers-reduced-motion: reduce) {
    .video__frame.is-playing {
      transform: none;
    }
  }
  /* O grain da faixa escura no palco: reforça a sensação de tela, não de caixa vazia. */
  .video__frame::after {
    border-radius: inherit;
  }
  /* O vídeo preenche o palco inteiro; o botão de espera some quando ele entra.
     :global obrigatório — o iframe nasce em runtime, sem o atributo de escopo do Astro,
     então uma regra escopada não o alcançaria (foi exatamente o bug do primeiro print:
     o player renderizou no tamanho default, um retângulo pequeno no meio do palco). */
  :global(.video__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
  }
  .video__frame.is-playing .video__play {
    opacity: 0;
  }

  /* Botão de play dentro do palco escuro: contorno osso, sem preenchimento claro. */
  .video__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    transition: opacity 300ms ease;
  }
  .video__fallback {
    color: var(--text-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .video__cta {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }
</style>
