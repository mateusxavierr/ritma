---
/**
 * Como funciona (redesign 2026-07-24 — elevado ao padrão das outras seções).
 * Faixa osso + 4 passos como cards com relevo (.card-lift) e numeral forte tom-sobre-tom.
 * Removidos (feedback do Mateus): a caixa "Transparência" (o ponto de prazo vive no FAQ)
 * e a micro-reassurance sob o CTA. Sem ícones — a tipografia e o numeral carregam (PLANO §5.6).
 * CTA de meio só em ≥768px (§10.26); no mobile a sticky bar cobre o meio.
 */
import CtaButton from './CtaButton.astro';

const passos = [
  {
    titulo: 'Consulta de viabilidade',
    corpo:
      'Você chama no WhatsApp e a Ritma pesquisa o seu nome nas bases do INPI. Sai sabendo se ele está disponível.',
  },
  {
    titulo: 'Estratégia',
    corpo:
      'Definição da classe e da forma de proteção certas pro seu negócio. Você entende cada escolha antes de aprovar.',
  },
  {
    titulo: 'Protocolo',
    corpo:
      'Pedido depositado no INPI. A partir daqui, quem chegar depois fica atrás de você na fila.',
  },
  {
    titulo: 'Acompanhamento',
    corpo:
      'A Ritma acompanha cada movimentação do processo e te avisa do que importa, até a decisão final.',
  },
];
/*
 * Variante pós-liberação (§10.23): título do passo 1 vira `Consulta gratuita`.
 */
---

<section class="bg-(--surface-alt)">
  <div class="container-page py-16 md:py-24">
    <p class="cf-eyebrow reveal">Do WhatsApp ao certificado</p>
    <h2 class="text-h2 reveal" style="--reveal-delay:80ms">Como funciona, sem juridiquês</h2>

    <ol class="cf-grid">
      {
        passos.map((p, i) => (
          <li class="cf-card card-lift reveal" style={`--reveal-delay:${120 + i * 90}ms`}>
            <span aria-hidden="true" class="cf-num">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-h3 cf-card__title">{p.titulo}</h3>
            <p class="cf-card__body">{p.corpo}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 hidden md:block reveal">
      <CtaButton align="start" origin="comofunciona" />
    </div>
  </div>
</section>

<style>
  .cf-eyebrow {
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .cf-grid {
    display: grid;
    gap: 16px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .cf-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 48px;
    }
  }

  .cf-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 24px 26px;
    background: var(--surface-page);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
  }
  /* faixa fina superior — sinal de “etapa”, tom-sobre-tom */
  .cf-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--border-strong);
  }

  .cf-num {
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--border-strong);
    margin-bottom: 14px;
  }
  @media (min-width: 768px) {
    .cf-num {
      font-size: 46px;
    }
  }
  .cf-card__title {
    margin-bottom: 8px;
  }
  .cf-card__body {
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-secondary);
  }
</style>
