---
/**
 * Para quem é (redesign 2026-07-23 — faixa escura + cards com foto).
 * 3 perfis em cards-imagem (retratos da Amanda em fundo escuro que funde na faixa),
 * headline + texto sobre scrim na base — estrutura da referência aprovada pelo Mateus.
 * Reveal escalonado no scroll (ponto 5). Paleta osso+chumbo travada.
 */
import { Picture } from 'astro:assets';
import imgComecando from '../assets/paraquem-comecando.jpg';
import imgConhecido from '../assets/paraquem-conhecido.jpg';
import imgComparando from '../assets/paraquem-comparando.jpg';

const perfis = [
  {
    img: imgComecando,
    titulo: 'Para você que está começando',
    corpo:
      'Vai investir em logo, embalagem e divulgação. Melhor construir tudo isso sobre um nome que já é seu.',
    pos: '50% 22%',
  },
  {
    img: imgConhecido,
    titulo: 'Para você que já é conhecido',
    corpo:
      'Seu nome já tem valor no mercado. Cada mês sem registro é uma aposta de que ninguém vai registrá-lo antes.',
    pos: '50% 20%',
  },
  {
    img: imgComparando,
    titulo: 'Para você que está comparando',
    corpo:
      'Quer saber o que está incluído e quem cuida do processo. A resposta está a uma mensagem de distância.',
    pos: '50% 18%',
  },
];
---

<section class="band-dark paraquem">
  <span class="texture-r" aria-hidden="true"></span>
  <div class="container-page py-16 md:py-24">
    <h2 class="text-h2 text-center reveal paraquem__title">Isso é pra você?</h2>
    <div class="paraquem__grid">
      {
        perfis.map((p, i) => (
          <article class="card-foto reveal" style={`--reveal-delay:${i * 120}ms`}>
            <Picture
              src={p.img}
              alt=""
              formats={['avif', 'webp']}
              widths={[360, 540, 720]}
              sizes="(min-width: 768px) 360px, 90vw"
              quality={80}
              loading="lazy"
              class="card-foto__img"
              style={`object-position:${p.pos}`}
            />
            <div class="card-foto__scrim" aria-hidden="true" />
            <div class="card-foto__body">
              <h3 class="text-h3">{p.titulo}</h3>
              <p>{p.corpo}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .paraquem__title {
    color: var(--text-on-dark);
    margin-bottom: 40px;
  }
  .paraquem__grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 768px) {
    .paraquem__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
  }

  .card-foto {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    background: var(--ink-950);
    box-shadow: 0 12px 34px rgb(20 21 21 / 0.35);
    isolation: isolate;
  }
  @media (min-width: 768px) {
    .card-foto {
      aspect-ratio: 3 / 4;
    }
  }
  .card-foto__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card-foto:hover .card-foto__img {
    transform: scale(1.04);
  }
  .card-foto__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgb(30 32 32 / 0) 32%,
      rgb(30 32 32 / 0.55) 62%,
      rgb(24 25 25 / 0.94) 100%
    );
  }
  .card-foto__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 24px;
    color: var(--text-on-dark);
  }
  .card-foto__body h3 {
    margin-bottom: 8px;
  }
  .card-foto__body p {
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: var(--text-on-dark-soft);
  }
</style>
