---
/**
 * Para quem é (redesign 2026-07-23 — faixa escura + cards com foto).
 * 3 perfis em cards-imagem. Imagens CONCEITUAIS geradas por IA (não a Amanda), na mesma
 * ambiência das fotos dela (fundo carvão, luz de estúdio, paleta neutra osso/chumbo) —
 * cada uma casa com a copy do card: rótulo sendo aplicado no pote (começando) → potes
 * prontos em série (conhecido) → duas mãos no mesmo pote (conflito). Estrutura aprovada.
 * Reveal escalonado no scroll (ponto 5).
 */
import { Picture } from 'astro:assets';
import imgComecando from '../assets/paraquem-comecando.jpg';
import imgConhecido from '../assets/paraquem-conhecido.jpg';
import imgConflito from '../assets/paraquem-conflito.jpg';

/* 2026-07-28 — enquadramento novo (Manolo, via Mateus): a seção deixa de rotular o leitor
   ("para você que…") e passa a descrever o MOMENTO do nome dele. Os três títulos viram uma
   escala — nasce → anda → é disputado — e a linha de fecho amarra no ritmo/crescimento. */
const perfis = [
  {
    img: imgComecando,
    titulo: 'O nome acabou de nascer',
    corpo:
      'Você está montando logo, embalagem e perfil. O nome merece ser seu antes de aparecer em tudo isso.',
    pos: '50% 40%',
  },
  {
    img: imgConhecido,
    titulo: 'O nome já anda sozinho',
    corpo:
      'As pessoas já procuram você por ele. Sem registro, cada mês é uma aposta de que ninguém vai chegar no INPI antes.',
    pos: '50% 42%',
  },
  {
    /* Perfil trocado pelo Mateus em 2026-07-24 (era "comparando"): agora é quem já está
       em conflito de marca — imagem de duas pessoas disputando o mesmo produto com o R. */
    img: imgConflito,
    titulo: 'O nome virou disputa',
    corpo:
      'Apareceu uma marca parecida demais, ou questionaram a sua. Situações assim têm defesa, e têm prazo.',
    pos: '50% 44%',
  },
];
---

<section class="band-dark paraquem">
  <span class="paraquem__glow" aria-hidden="true"></span>
  <div class="container-page py-16 md:py-24">
    {/* Título trocado pelo Mateus em 2026-07-24 (era "Isso é pra você?"), e de novo em
        2026-07-28 (era "Quem precisa dos serviços da Ritma?"). */}
    <h2 class="text-h2 text-center reveal paraquem__title">Em que momento o seu negócio está?</h2>
    <div class="paraquem__grid">
      {
        perfis.map((p, i) => (
          <article class="card-foto reveal" style={`--reveal-delay:${i * 120}ms`}>
            <Picture
              src={p.img}
              alt=""
              formats={['avif', 'webp']}
              widths={[360, 540, 720]}
              sizes="(min-width: 768px) 360px, 90vw"
              quality={80}
              loading="lazy"
              class="card-foto__img"
              style={`object-position:${p.pos}`}
            />
            <div class="card-foto__scrim" aria-hidden="true" />
            <span class="card-foto__seal" aria-hidden="true">&#174;</span>
            <div class="card-foto__body">
              <h3 class="text-h3">{p.titulo}</h3>
              <p>{p.corpo}</p>
            </div>
          </article>
        ))
      }
    </div>

    {/* Fecho da seção (2026-07-28): amarra os três momentos numa promessa só. É o único
        lugar da página onde o trocadilho ritmo/Ritma aparece — repetir mata. */}
    <p class="paraquem__fecho reveal" style="--reveal-delay:420ms">
      Em qualquer um desses momentos, a Ritma acompanha o <strong>ritmo do seu crescimento</strong>.
    </p>
  </div>
</section>

<style>
  /* Luz de estúdio: foco radial suave atrás dos cards (só luminância, sem cor nova) */
  .paraquem__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(58% 46% at 50% 46%, rgb(255 255 255 / 0.06), transparent 72%),
      radial-gradient(90% 60% at 50% 120%, rgb(20 21 21 / 0.5), transparent 70%);
  }
  .paraquem__title {
    color: var(--text-on-dark);
    margin-bottom: 40px;
  }
  .paraquem__grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 768px) {
    .paraquem__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
  }

  /* Fecho: medida curta e centrada pra ler como remate da seção, não como parágrafo novo. */
  .paraquem__fecho {
    max-width: 46ch;
    margin: 32px auto 0;
    text-align: center;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--text-on-dark-soft);
  }
  .paraquem__fecho strong {
    font-weight: 700;
    color: var(--text-on-dark);
  }

  .card-foto {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    background: var(--ink-950);
    box-shadow: 0 12px 34px rgb(20 21 21 / 0.35);
    isolation: isolate;
  }
  @media (min-width: 768px) {
    .card-foto {
      aspect-ratio: 3 / 4;
    }
  }
  .card-foto__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card-foto:hover .card-foto__img {
    transform: scale(1.04);
  }
  .card-foto__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgb(30 32 32 / 0) 32%,
      rgb(30 32 32 / 0.55) 62%,
      rgb(24 25 25 / 0.94) 100%
    );
  }
  /* Selo ® — âncora de "registro de marca", vetor nítido (nunca gerado por IA — decisão do council).
     Discreto, canto superior direito, consistente nos 3 cards. */
  .card-foto__seal {
    position: absolute;
    top: 14px;
    right: 16px;
    z-index: 3;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--sand-100); /* sobre FOTO: osso fixo, não acompanha a faixa */
    opacity: 0.62;
  }

  .card-foto__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 24px;
    color: var(--sand-100); /* sobre FOTO: osso fixo */
  }
  .card-foto__body h3 {
    margin-bottom: 8px;
  }
  .card-foto__body p {
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    color: color-mix(in srgb, var(--sand-100) 78%, transparent); /* sobre FOTO */
  }
</style>
