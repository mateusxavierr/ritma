---
/**
 * Botão flutuante do WhatsApp (redesign 2026-07-23, pedido do Mateus).
 * Bolinha verde no canto inferior direito, glifo WA, mesmo href/intent do CTA único.
 * Exceção consciente à paleta de 2 cores: verde oficial do WhatsApp (#25D366) é a
 * convenção de plataforma que o Mateus pediu explicitamente.
 * z-index 45 (acima da sticky bar 40). No mobile sobe pra não colidir com a sticky bar.
 */
import { CTA_ARIA_LABEL, waHref } from '../config';
---

<a href={waHref('fab')} class="wa-fab" aria-label={CTA_ARIA_LABEL} target="_blank" rel="noopener">
  <span class="wa-fab__pulse" aria-hidden="true"></span>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="30" height="30">
    <use href="#wa-icon"></use>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: 20px;
    bottom: 88px; /* mobile: acima da sticky bar (56px) + folga */
    z-index: 45;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow:
      0 6px 16px rgb(37 211 102 / 0.4),
      0 2px 6px rgb(0 0 0 / 0.2);
    transition:
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms ease;
    animation: fabIn 400ms cubic-bezier(0.22, 1, 0.36, 1) 600ms both;
  }
  @media (min-width: 768px) {
    .wa-fab {
      right: 28px;
      bottom: 28px; /* desktop: sem sticky bar, encosta embaixo */
      width: 62px;
      height: 62px;
    }
  }
  .wa-fab:hover {
    transform: scale(1.06);
    box-shadow:
      0 8px 22px rgb(37 211 102 / 0.5),
      0 3px 8px rgb(0 0 0 / 0.22);
  }
  .wa-fab:active {
    transform: scale(0.97);
  }

  /* Anel de pulso sutil */
  .wa-fab__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    z-index: -1;
    animation: fabPulse 2.4s ease-out infinite;
  }

  @keyframes fabIn {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fabPulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      animation: none;
    }
    .wa-fab__pulse {
      animation: none;
      display: none;
    }
  }
</style>
