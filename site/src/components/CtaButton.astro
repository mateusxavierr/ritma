---
/**
 * O botão único da página (PLANO §9, §10.9): mesmo intent, mesmo label, mesmo href
 * em todas as instâncias. Tudo vem de src/config.ts.
 * Único glifo SVG da página: WhatsApp monocromático inline (exceção registrada, PLANO §1, §10.19).
 */
import { CTA_ARIA_LABEL, CTA_LABEL, CTA_REASSURANCE, waHref } from '../config';

interface Props {
  /** solid = chumbo sobre claro · inverse = osso sobre o bloco escuro (PLANO §2.1) */
  variant?: 'solid' | 'inverse';
  /** lg = instâncias de conversão (56px) · sm = botão compacto do header (§5.1) */
  size?: 'lg' | 'sm';
  /** ocupa a largura toda (CTA do card de oferta, mobile do hero) */
  block?: boolean;
  /** exibe a micro-reassurance sob o botão (hero/meio/oferta/CTA final — §4.1) */
  reassurance?: boolean;
  /** alinhamento do bloco (botão + reassurance) */
  align?: 'start' | 'center';
  /** origem do clique → mensagem personalizada do WhatsApp (config.ts WA_MESSAGES) */
  origin?: string;
  /** label próprio (ex.: enquadramento persuasivo "Começar pela etapa 1…") — mesmo href/intent.
      Default = CTA_LABEL único (§10.9). Usar só em placement específico, com justificativa. */
  label?: string;
  id?: string;
}

const {
  variant = 'solid',
  size = 'lg',
  block = false,
  reassurance = false,
  align = 'start',
  origin = 'default',
  label = CTA_LABEL,
  id,
} = Astro.props;

const ariaLabel = label === CTA_LABEL ? CTA_ARIA_LABEL : `${label} pelo WhatsApp`;
---

<div id={id} class:list={['cta-block', align === 'center' && 'cta-center', block && 'cta-fill']}>
  <a
    href={waHref(origin)}
    aria-label={ariaLabel}
    class:list={['cta', `cta-${variant}`, `cta-${size}`, block && 'w-full']}
  >
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <use href="#wa-icon"></use>
    </svg>
    <span>{label}</span>
  </a>
  {reassurance && <p class="cta-reassurance">{CTA_REASSURANCE}</p>}
</div>

<style>
  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .cta-center {
    align-items: center;
    text-align: center;
  }
  .cta-fill {
    align-items: stretch;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      transform 150ms ease;
  }
  .cta:active {
    transform: translateY(1px);
  }

  .cta-solid {
    background-color: var(--cta-bg);
    color: var(--cta-text);
  }
  .cta-solid:hover {
    background-color: var(--cta-bg-hover);
  }

  /* CTA invertido do bloco escuro: fonte ≥17px/700 (contraste AA em §2.1) */
  .cta-inverse {
    background-color: var(--cta-inverse-bg);
    color: var(--cta-inverse-text);
  }

  /* Contorno hairline SÓ dentro de faixa escura: petróleo sobre chumbo tem ~1.1:1 de
     contraste de borda (o rótulo se lê, o botão não se acha). Sobre faixa clara o petróleo
     já tem 9.5:1 contra o fundo e a linha só sujaria. */
  :global(.band-dark) .cta-solid,
  :global(.band-dark) .cta-inverse {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--petrol-200) 42%, transparent);
  }
  .cta-inverse:hover {
    background-color: var(--cta-inverse-bg-hover);
  }

  .cta-lg {
    min-height: 56px;
    padding: 12px 20px;
    font-size: 16px;
    line-height: 1.25;
    text-align: center;
  }

  /* 2026-07-28 (Mateus): uma linha SEMPRE no mobile — antes o label quebrava em duas.
     Como o botão aparece em contextos de largura diferente (solto no container ou dentro
     do card da Oferta, que soma o próprio padding), vw não serve de régua: a fonte é
     calculada sobre a largura REAL do bloco, via container query.

     A conta: o label mede 18,41px de largura por 1px de fonte (medido na Catamaran 700).
     Divisor 19.2 = esses 18,41 + ~4% de folga pra antialiasing e arredondamento.
     Os 46px descontados são o cromo do botão: 24 de padding + 16 de glifo + 6 de gap. */
  @media (max-width: 767.98px) {
    .cta-block {
      width: 100%;
      container-type: inline-size;
    }
    /* Era `display: block` (ajuste 7 do council): com o rótulo em DUAS linhas, o fluxo
       inline era o que impedia o glifo de ficar órfão na esquerda enquanto o texto
       centrava. Com uma linha só esse motivo sumiu — e o block passou a ancorar o texto
       no topo, deixando toda a sobra do min-height embaixo. Volta pro flex, que centra
       nos dois eixos e alinha o glifo de graça. */
    .cta-lg {
      display: flex;
      width: 100%;
      gap: 6px;
      padding-inline: 12px;
      white-space: nowrap;
      font-size: min(16px, calc((100cqw - 46px) / 19.2));
    }
    .cta-lg svg {
      flex: none;
      width: 16px;
      height: 16px;
    }
  }

  /* Abaixo de 360px o glifo sai: em tela dessa largura ele custa 22px, que valem ~1,2px
     de fonte — e rótulo legível pesa mais que ícone. Mesma decisão já vigente no .cta-sm. */
  @media (max-width: 359.98px) {
    .cta-lg svg {
      display: none;
    }
    .cta-lg {
      font-size: min(16px, calc((100cqw - 24px) / 19.2));
    }
  }
  @media (min-width: 768px) {
    .cta-lg {
      padding: 16px 32px;
      font-size: 17px;
      line-height: 1;
      white-space: nowrap;
    }
  }

  /* Botão compacto do header (§5.1): visual menor, área de toque ≥48x48 via ::after.
     No mobile o glifo sai (label + ícone não coexistem em 360-375px sem quebrar linha). */
  .cta-sm {
    position: relative;
    padding: 8px 14px;
    font-size: 14px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .cta-sm svg {
    display: none;
    width: 16px;
    height: 16px;
  }
  @media (min-width: 768px) {
    .cta-sm svg {
      display: block;
    }
  }
  .cta-sm::after {
    content: '';
    position: absolute;
    inset: -6px 0;
  }
  @media (min-width: 768px) {
    .cta-sm {
      padding: 10px 20px;
      font-size: 15px;
    }
    .cta-sm::after {
      inset: 0;
    }
  }
  /* Guarda pra viewports ≤359px: o label único não pode quebrar linha */
  @media (max-width: 359px) {
    .cta-sm {
      padding: 8px 10px;
      font-size: 12.5px;
    }
  }

  .cta-reassurance {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    color: var(--text-secondary);
  }
</style>
