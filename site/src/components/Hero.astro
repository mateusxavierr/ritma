---
/**
 * Hero (redesign 2026-07-23 — faixa escura + vinheta + foto da Amanda).
 * — Faixa chumbo com profundidade (gradiente + vinheta radial + textura de R).
 * — Assinatura animada da marca: RITMA revelado LETRA POR LETRA (5 camadas do SVG osso
 *   recortadas nos vãos medidos) + REGISTROS entrando depois, mais rápido, com tracking
 *   largo — mesma coreografia da vinheta oficial (docs/marca/.../Ritma vertical.mp4).
 * — Headline: copy do panfleto A6 ("Quem não registra, perde.").
 * — Foto: photo 5 (Amanda sentada, mão no queixo, fundo escuro) fundindo no fundo via máscara.
 * Paleta travada em osso+chumbo (PDF de diretrizes) — sem cor nova, sem glow colorido.
 */
import { Picture } from 'astro:assets';
import heroAmanda from '../assets/hero-amanda.jpg';
import copy from '../copy.json';

/* O subtítulo é o ÚNICO texto com marcação: **negrito** vira <strong>. Nada mais é
   interpretado, e a fonte é um JSON do próprio repositório — sem entrada de terceiro. */
const subHtml = copy.hero.sub.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
import CtaButton from './CtaButton.astro';

// Bandas de recorte de cada letra do RITMA (medidas por cobertura de tinta do SVG osso).
// tx = deslocamento horizontal inicial (% da largura): a palavra nasce comprimida no centro
// e EXPANDE pras posições finais (R vai pro começo, A pro fim) — a coreografia da vinheta.
const letras = [
  { k: 'R', clip: 'inset(0 78.5% 0 0)', tx: '25.5%' },
  { k: 'I', clip: 'inset(0 70% 0 21.5%)', tx: '15.8%' },
  { k: 'T', clip: 'inset(0 53% 0 30%)', tx: '7.5%' },
  { k: 'M', clip: 'inset(0 21% 0 47%)', tx: '-8.5%' },
  { k: 'A', clip: 'inset(0 0 0 79%)', tx: '-25.7%' },
];
---

<section class="hero band-light">
  <div class="container-page hero__grid">
    <div class="hero__content">
      {/* Assinatura da marca — decorativa; o texto acessível vai no aria-label */}
      <div class="wordmark" role="img" aria-label="Ritma Registros">
        <div class="wordmark__ritma">
          {
            letras.map((l, i) => (
              <span
                class="wordmark__letter"
                style={`clip-path:${l.clip};-webkit-clip-path:${l.clip};--tx:${l.tx};animation-delay:${120 + i * 85}ms`}
              />
            ))
          }
        </div>
        <div class="wordmark__registros" aria-hidden="true">Registros</div>
      </div>

      {/* Texto vem de src/copy.json — mesma fonte dos metadados de compartilhamento e do
          texto dentro do og.png, pra eyebrow/título e OG nunca divergirem (regra do Mateus).
          Eyebrow em 31 caracteres: teto pra 1 linha em caixa alta a 375px.
          H1 com 93 caracteres usa a escala própria .hero__title, menor que --text-display. */}
      <p class="hero__eyebrow">{copy.hero.eyebrow}</p>
      <h1 class="hero__title">{copy.hero.title}</h1>
      <p class="hero__sub" set:html={subHtml} />
      <div class="hero__cta">
        <CtaButton id="hero-cta" variant="inverse" block align="start" origin="hero" />
      </div>
    </div>

    <div class="hero__figure">
      <Picture
        src={heroAmanda}
        alt="Amanda Pereira, especialista em registro de marcas da Ritma Registros"
        formats={['avif', 'webp']}
        widths={[440, 700, 1000, 1200, 1500]}
        sizes="(min-width: 1024px) 600px, 100vw"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero__photo"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }
  /* Mobile: hero completo em UMA tela (foto no topo + conteúdo compacto) — pedido do Mateus.
     padding-top: 0 → a foto sobe ATRÁS do header transparente (sem faixa/corte no topo). */
  .hero__grid {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: 0;
    padding-bottom: 18px;
  }
  .hero__content {
    flex: none;
  }

  /* ——— Assinatura RITMA REGISTROS (vinheta) ——— */
  .wordmark {
    margin-bottom: 14px;
  }
  .wordmark__ritma {
    position: relative;
    width: min(186px, 50vw);
    aspect-ratio: 499.26 / 128.27;
  }
  .wordmark__letter {
    position: absolute;
    inset: 0;
    /* Faixa clara desde 2026-07-24: wordmark CHUMBO (o osso sumiria no osso). */
    background: url('/ritma/logo-ritma-chumbo.svg') no-repeat center / contain;
    opacity: 0;
    animation: letterIn 640ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .wordmark__registros {
    margin-top: 10px;
    padding-left: 3px;
    font-size: clamp(0.72rem, 0.62rem + 0.5vw, 0.9rem);
    font-weight: 600;
    letter-spacing: 0.62em;
    text-indent: 0.62em;
    text-transform: uppercase;
    color: var(--text-on-dark-soft);
    opacity: 0;
    transform: translateY(6px);
    animation: registrosIn 520ms ease-out 860ms both;
  }

  @keyframes letterIn {
    from {
      opacity: 0;
      transform: translate(var(--tx, 0), 0.55em) scale(0.985);
      filter: blur(3px);
    }
    55% {
      filter: blur(0);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) scale(1);
      filter: blur(0);
    }
  }
  @keyframes registrosIn {
    from {
      opacity: 0;
      letter-spacing: 0.3em;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      letter-spacing: 0.62em;
      transform: translateY(0);
    }
  }

  /* ——— Texto do hero (entra depois da assinatura) ——— */
  .hero__eyebrow {
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-on-dark-soft);
    margin-bottom: 12px;
  }
  /* Escala própria, menor que --text-display (34→56px): o H1 tem 93 caracteres e em display
     cheio ocupa 5 linhas no mobile, empurrando o CTA pra fora da primeira tela. Título longo
     pede corpo menor — a hierarquia continua intacta porque nada mais no hero compete. */
  .hero__title {
    color: var(--text-on-dark);
    font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.375rem); /* 24→38px */
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-weight: 800;
    max-width: 26ch;
  }
  .hero__sub {
    margin-top: 12px;
    max-width: 46ch;
    color: var(--text-on-dark-soft);
  }
  /* Negrito do subtítulo: sobe do texto suave (70% do osso) pro osso cheio. O peso sozinho
     não bastava sobre fundo escuro — sem o ganho de luminância a ênfase some. */
  .hero__sub :global(strong) {
    font-weight: 700;
    color: var(--text-on-dark);
  }
  .hero__cta {
    margin-top: 20px;
  }

  /* entrada suave e escalonada do conteúdo (acima da dobra → animação, não scroll) */
  .hero__eyebrow,
  .hero__title,
  .hero__sub,
  .hero__cta,
  .hero__figure {
    opacity: 0;
    animation: heroRise 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero__eyebrow {
    animation-delay: 1150ms;
  }
  .hero__title {
    animation-delay: 1250ms;
  }
  .hero__sub {
    animation-delay: 1380ms;
  }
  .hero__cta {
    animation-delay: 1500ms;
  }
  .hero__figure {
    animation-delay: 420ms;
  }
  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ——— Foto da Amanda ——— */
  /* Mobile: foto no TOPO (order -1), full-bleed, altura controlada — funde na base pro texto */
  .hero__figure {
    position: relative;
    order: -1;
    flex: 1 1 0;
    min-height: 0;
    margin: 0 -20px 4px;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    display: block;
    border-radius: 0;
    /* rosto visível no topo; funde na base pro texto */
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 66%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 66%, transparent 100%);
  }

  /* ——— Desktop (reseta o layout mobile de uma tela) ——— */
  @media (min-width: 1024px) {
    .hero__grid {
      display: grid;
      grid-template-columns: 1fr 0.92fr;
      align-items: center;
      min-height: 0;
      gap: 40px;
      padding-top: 104px;
      padding-bottom: 88px;
    }
    .hero__content {
      display: block;
      flex: initial;
    }
    .hero__figure {
      order: 2;
      flex: initial;
      margin: 0;
      align-self: center;
    }
    .wordmark {
      margin-bottom: 28px;
    }
    .wordmark__ritma {
      width: 340px;
    }
    .hero__photo {
      position: static;
      width: 100%;
      max-width: 600px;
      height: auto;
      object-fit: fill;
      border-radius: 0;
      /* melt simétrico nas 4 bordas — esquerda = direita (feedback do Mateus).
         mask-composite intersect é ESSENCIAL: sem ele os 2 gradientes se somam (union) e a
         foto vira retângulo. Restaurado após a reestruturação do mobile. */
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 24% 76%, transparent),
        linear-gradient(180deg, transparent, #000 14% 86%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 24% 76%, transparent),
        linear-gradient(180deg, transparent, #000 14% 86%, transparent);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark__letter,
    .wordmark__registros,
    .hero__eyebrow,
    .hero__title,
    .hero__sub,
    .hero__cta,
    .hero__figure {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      letter-spacing: 0.62em;
    }
    .wordmark__letter {
      letter-spacing: normal;
    }
  }
</style>
