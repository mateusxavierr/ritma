---
/**
 * Hero (redesign 2026-07-23 — faixa escura + vinheta + foto da Amanda).
 * — Faixa chumbo com profundidade (gradiente + vinheta radial + textura de R).
 * — Assinatura animada da marca: RITMA revelado LETRA POR LETRA (5 camadas do SVG osso
 *   recortadas nos vãos medidos) + REGISTROS entrando depois, mais rápido, com tracking
 *   largo — mesma coreografia da vinheta oficial (docs/marca/.../Ritma vertical.mp4).
 * — Headline: copy do panfleto A6 ("Quem não registra, perde.").
 * — Foto: photo 5 (Amanda sentada, mão no queixo, fundo escuro) fundindo no fundo via máscara.
 * Paleta travada em osso+chumbo (PDF de diretrizes) — sem cor nova, sem glow colorido.
 */
import { Picture } from 'astro:assets';
import heroAmanda from '../assets/hero-amanda.jpg';
import CtaButton from './CtaButton.astro';

// Bandas de recorte de cada letra do RITMA (medidas por cobertura de tinta do SVG osso).
// tx = deslocamento horizontal inicial (% da largura): a palavra nasce comprimida no centro
// e EXPANDE pras posições finais (R vai pro começo, A pro fim) — a coreografia da vinheta.
const letras = [
  { k: 'R', clip: 'inset(0 78.5% 0 0)', tx: '25.5%' },
  { k: 'I', clip: 'inset(0 70% 0 21.5%)', tx: '15.8%' },
  { k: 'T', clip: 'inset(0 53% 0 30%)', tx: '7.5%' },
  { k: 'M', clip: 'inset(0 21% 0 47%)', tx: '-8.5%' },
  { k: 'A', clip: 'inset(0 0 0 79%)', tx: '-25.7%' },
];
---

<section class="hero band-dark">
  <span class="texture-r" aria-hidden="true"></span>
  <div class="container-page hero__grid">
    <div class="hero__content">
      {/* Assinatura da marca — decorativa; o texto acessível vai no aria-label */}
      <div class="wordmark" role="img" aria-label="Ritma Registros">
        <div class="wordmark__ritma">
          {
            letras.map((l, i) => (
              <span
                class="wordmark__letter"
                style={`clip-path:${l.clip};-webkit-clip-path:${l.clip};--tx:${l.tx};animation-delay:${120 + i * 85}ms`}
              />
            ))
          }
        </div>
        <div class="wordmark__registros" aria-hidden="true">Registros</div>
      </div>

      <p class="hero__eyebrow">Registro de marca no INPI</p>
      <h1 class="hero__title text-display">Quem não registra, perde.</h1>
      <p class="hero__sub">
        A sua marca é realmente sua? No Brasil, a marca é de quem registra primeiro no INPI — não de
        quem usa há mais tempo.
      </p>
      <div class="hero__cta">
        <CtaButton id="hero-cta" variant="inverse" reassurance block align="start" />
      </div>
    </div>

    <div class="hero__figure">
      <Picture
        src={heroAmanda}
        alt="Amanda Pereira, especialista em registro de marcas da Ritma Registros"
        formats={['avif', 'webp']}
        widths={[420, 700, 1000, 1400]}
        sizes="(min-width: 1024px) 520px, 100vw"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero__photo"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: 12px;
    padding-top: 92px; /* limpa o header fixo que sobrepõe o hero */
    padding-bottom: 40px;
  }

  /* ——— Assinatura RITMA REGISTROS (vinheta) ——— */
  .wordmark {
    margin-bottom: 28px;
  }
  .wordmark__ritma {
    position: relative;
    width: min(300px, 62vw);
    aspect-ratio: 499.26 / 128.27;
  }
  .wordmark__letter {
    position: absolute;
    inset: 0;
    background: url('/logo-ritma-osso.svg') no-repeat center / contain;
    opacity: 0;
    animation: letterIn 640ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .wordmark__registros {
    margin-top: 10px;
    padding-left: 3px;
    font-size: clamp(0.72rem, 0.62rem + 0.5vw, 0.9rem);
    font-weight: 600;
    letter-spacing: 0.62em;
    text-indent: 0.62em;
    text-transform: uppercase;
    color: var(--text-on-dark-soft);
    opacity: 0;
    transform: translateY(6px);
    animation: registrosIn 520ms ease-out 860ms both;
  }

  @keyframes letterIn {
    from {
      opacity: 0;
      transform: translate(var(--tx, 0), 0.55em) scale(0.985);
      filter: blur(3px);
    }
    55% {
      filter: blur(0);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) scale(1);
      filter: blur(0);
    }
  }
  @keyframes registrosIn {
    from {
      opacity: 0;
      letter-spacing: 0.3em;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      letter-spacing: 0.62em;
      transform: translateY(0);
    }
  }

  /* ——— Texto do hero (entra depois da assinatura) ——— */
  .hero__eyebrow {
    font-size: var(--text-caption);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-on-dark-soft);
    margin-bottom: 12px;
  }
  .hero__title {
    color: var(--text-on-dark);
    max-width: 15ch;
  }
  .hero__sub {
    margin-top: 18px;
    max-width: 40ch;
    color: var(--text-on-dark-soft);
  }
  .hero__cta {
    margin-top: 28px;
  }

  /* entrada suave e escalonada do conteúdo (acima da dobra → animação, não scroll) */
  .hero__eyebrow,
  .hero__title,
  .hero__sub,
  .hero__cta,
  .hero__figure {
    opacity: 0;
    animation: heroRise 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero__eyebrow {
    animation-delay: 1150ms;
  }
  .hero__title {
    animation-delay: 1250ms;
  }
  .hero__sub {
    animation-delay: 1380ms;
  }
  .hero__cta {
    animation-delay: 1500ms;
  }
  .hero__figure {
    animation-delay: 420ms;
  }
  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ——— Foto da Amanda ——— */
  .hero__figure {
    position: relative;
    margin-top: 8px;
  }
  .hero__photo {
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
    display: block;
    border-radius: 18px;
    /* funde a foto no fundo escuro — degradê simétrico nas laterais (o fundo dela já é ~chumbo) */
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent),
      linear-gradient(90deg, transparent, #000 14% 86%, transparent);
    mask-image: linear-gradient(180deg, #000 70%, transparent),
      linear-gradient(90deg, transparent, #000 14% 86%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  /* ——— Desktop ——— */
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr 0.82fr;
      align-items: center;
      gap: 48px;
      padding-top: 104px;
      padding-bottom: 88px;
    }
    .hero__figure {
      order: 2;
      margin-top: 0;
      align-self: stretch;
    }
    .wordmark__ritma {
      width: 340px;
    }
    .hero__photo {
      max-width: 500px;
      border-radius: 0;
      /* melt simétrico nas 4 bordas — esquerda = direita (feedback do Mateus) */
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 24% 76%, transparent),
        linear-gradient(180deg, transparent, #000 14% 86%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 24% 76%, transparent),
        linear-gradient(180deg, transparent, #000 14% 86%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark__letter,
    .wordmark__registros,
    .hero__eyebrow,
    .hero__title,
    .hero__sub,
    .hero__cta,
    .hero__figure {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      letter-spacing: 0.62em;
    }
    .wordmark__letter {
      letter-spacing: normal;
    }
  }
</style>
