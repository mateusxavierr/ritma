---
/**
 * Sticky CTA bar mobile (PLANO §5.12): ÚNICO elemento fixo da página.
 *
 * Regra nova (Mateus, 2026-07-24): TODO botão do desktop também existe no mobile, e a barra
 * é quem se ajusta — ela aparece só quando NENHUM botão de conversão está na tela. Resultado:
 * sempre há exatamente um botão visível, seja o da seção, seja a barra.
 * Antes ela observava só o CTA do hero e o do bloco final; agora observa todos os .cta-lg.
 * z-index 40: único z alto da página.
 */
import { CTA_ARIA_LABEL, CTA_LABEL, waHref } from '../config';
---

<div id="sticky-cta" class="sticky-bar md:hidden">
  <a href={waHref('default')} aria-label={CTA_ARIA_LABEL} class="sticky-link">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <use href="#wa-icon"></use>
    </svg>
    <span>{CTA_LABEL}</span>
  </a>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById('sticky-cta');
    if (!bar || !('IntersectionObserver' in window)) return;

    // Todos os botões de conversão da página (o .cta-sm do header fica de fora: é secundário
    // e vive num header fixo, então nunca deixaria a barra aparecer).
    var botoes = document.querySelectorAll('.cta-lg');
    if (!botoes.length) return;

    var naTela = new Set();
    var obs = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) naTela.add(e.target);
          else naTela.delete(e.target);
        });
        bar.classList.toggle('is-visible', naTela.size === 0);
      },
      // Sem margem negativa (2026-07-24): ela descontava os 84px de baixo pra ignorar botão
      // escondido atrás da barra, mas no estado de ENTRADA do mobile o CTA do hero fica
      // justamente ali, coladinho no rodapé da primeira tela — e a barra subia por cima dele,
      // dois botões empilhados. Regra agora é literal: um pixel de botão na tela, barra fora.
      { rootMargin: '0px' }
    );
    botoes.forEach(function (b) {
      obs.observe(b);
    });
  })();
</script>

<style>
  /* Pílula flutuante (melhorada — feedback do Mateus): margens, cantos e sombra,
     em vez de barra colada na borda. */
  .sticky-bar {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 40;
    background: var(--cta-bg);
    border-radius: 16px;
    /* inset hairline: mesmo motivo do botão (petróleo sobre chumbo não tem borda própria) */
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--petrol-200) 42%, transparent),
      0 8px 26px rgb(0 0 0 / 0.45),
      0 2px 6px rgb(0 0 0 / 0.3);
    transform: translateY(calc(100% + 16px));
    visibility: hidden;
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 280ms;
  }
  .sticky-bar.is-visible {
    transform: translateY(0);
    visibility: visible;
  }
  .sticky-link {
    display: flex;
    height: 58px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 16px;
    color: var(--cta-text);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
  }
  .sticky-link:active {
    transform: translateY(1px);
  }
  .sticky-bar :focus-visible {
    outline-color: var(--text-on-inverse-2);
  }
  /* O label único não pode quebrar linha em viewports estreitos */
  @media (max-width: 379px) {
    .sticky-link {
      font-size: 15px;
    }
  }
</style>
