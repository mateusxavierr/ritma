---
/**
 * Sticky CTA bar mobile (PLANO §5.12): ÚNICO elemento fixo da página.
 * Nunca no primeiro paint; aparece quando o CTA do hero sai da viewport e some
 * enquanto o bloco escuro de fechamento está visível (evita CTA duplicado e
 * chumbo-sobre-chumbo ilegível). z-index 40: único z alto da página.
 */
import { CTA_ARIA_LABEL, CTA_LABEL, waHref } from '../config';
---

<div id="sticky-cta" class="sticky-bar md:hidden">
  <a href={waHref('default')} aria-label={CTA_ARIA_LABEL} class="sticky-link">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <use href="#wa-icon"></use>
    </svg>
    <span>{CTA_LABEL}</span>
  </a>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById('sticky-cta');
    var heroCta = document.getElementById('hero-cta');
    var ctaFinal = document.getElementById('cta-final');
    if (!bar || !heroCta || !ctaFinal || !('IntersectionObserver' in window)) return;
    var heroVisible = true;
    var finalVisible = false;
    var update = function () {
      bar.classList.toggle('is-visible', !heroVisible && !finalVisible);
    };
    new IntersectionObserver(function (entries) {
      heroVisible = entries[entries.length - 1].isIntersecting;
      update();
    }).observe(heroCta);
    new IntersectionObserver(function (entries) {
      finalVisible = entries[entries.length - 1].isIntersecting;
      update();
    }).observe(ctaFinal);
  })();
</script>

<style>
  /* Pílula flutuante (melhorada — feedback do Mateus): margens, cantos e sombra,
     em vez de barra colada na borda. */
  .sticky-bar {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 40;
    background: var(--cta-bg);
    border-radius: 16px;
    box-shadow:
      0 8px 26px rgb(20 21 21 / 0.3),
      0 2px 6px rgb(0 0 0 / 0.2);
    transform: translateY(calc(100% + 16px));
    visibility: hidden;
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 280ms;
  }
  .sticky-bar.is-visible {
    transform: translateY(0);
    visibility: visible;
  }
  .sticky-link {
    display: flex;
    height: 58px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 16px;
    color: var(--cta-text);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
  }
  .sticky-link:active {
    transform: translateY(1px);
  }
  .sticky-bar :focus-visible {
    outline-color: var(--text-on-inverse-2);
  }
  /* O label único não pode quebrar linha em viewports estreitos */
  @media (max-width: 379px) {
    .sticky-link {
      font-size: 15px;
    }
  }
</style>
