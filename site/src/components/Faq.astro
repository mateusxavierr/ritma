---
/**
 * FAQ (PLANO §5.10): 8 objeções canônicas em <details>/<summary> nativos —
 * teclado e leitor de tela de graça, zero JS, múltiplos abertos permitidos.
 */
const itens = [
  {
    p: 'Já uso meu nome há anos. Ele não é meu automaticamente?',
    r: 'Não. No Brasil o direito sobre a marca nasce do registro no INPI. Usar há mais tempo ajuda muito pouco se outra pessoa registrar primeiro.',
  },
  {
    p: 'Minha empresa é pequena. Vale a pena registrar?',
    r: 'É justamente quem é pequeno que não tem caixa pra recomeçar: trocar nome, fachada, embalagem e perfil dói mais no pequeno. E a taxa do INPI tem desconto de 50% pra MEI, micro e pequenas empresas.',
  },
  {
    p: 'Quanto custa?',
    // Formulação validada pela Amanda (2026-07-24): valor de honorário na página a OAB
    // entende como captação de clientela. Taxa do INPI é dado público, pode.
    r: 'A taxa oficial do INPI parte de R$ 440 por classe com o desconto legal para MEI, micro e pequenas empresas e pessoas físicas. Os honorários são definidos de acordo com as particularidades de cada caso. Entre em contato para receber uma proposta personalizada.',
  },
  {
    p: 'Quanto tempo demora?',
    // Médias divulgadas pelo próprio INPI (confirmadas pela Amanda em 2026-07-24).
    r: 'O protocolo é a parte rápida. O exame é a fila do INPI: o próprio órgão informa cerca de 18 meses para um pedido sem oposição e cerca de 22 meses quando há oposição, em trâmite regular. O que importa: sua prioridade vale desde o protocolo, não desde a decisão.',
  },
  {
    p: 'É muito burocrático?',
    r: 'A burocracia existe, mas ela é nossa. Do seu lado, uma conversa de WhatsApp e os documentos básicos. Do nosso, o resto.',
  },
  {
    p: 'Posso registrar sozinho no INPI?',
    r: 'Pode, o sistema é público. Os riscos de fazer sem apoio técnico: pesquisa de anterioridade incompleta, classe errada e exigências que pedem argumentação jurídica. Se o pedido for negado, a taxa não volta.',
  },
  {
    p: 'Preciso ter CNPJ?',
    r: 'Não. Pessoa física também registra, desde que exerça atividade ligada à marca.',
  },
  {
    p: 'Registrei. Acabou?',
    r: 'O registro vale 10 anos e é renovável indefinidamente. Vale acompanhar o mercado: quem registra tem o direito de se opor a pedidos parecidos com o seu.',
  },
];
---

<section class="band-light band-light--page">
  <div class="container-page py-16 md:py-24">
    <div class="mx-auto max-w-[720px]">
      <h2 class="text-h2 reveal">O que todo mundo pergunta</h2>
      <div class="faq-list mt-8">
        {
          itens.map((item, i) => (
            <details class="faq-item reveal border-b border-(--border-subtle)" style={`--reveal-delay:${i * 55}ms`}>
              <summary>
                <span>{item.p}</span>
                <span aria-hidden="true" class="chev" />
              </summary>
              <div class="faq-panel">
                <div class="faq-content prose-measure pb-5 text-body-sm text-(--text-secondary)">
                  {item.r}
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px; /* área clicável ≥56px (§5.10) */
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
    transition: color 150ms ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    /* Com o site escuro (2026-07-24), o hover não pode escurecer: clareia pro osso cheio.
       (Histórico: era --cta-bg-hover, depois --ink-900.) */
    color: var(--text-primary);
  }
  details[open] summary {
    font-weight: 700;
  }

  /* Chevron em CSS puro (§5.10): sem pacote de ícones */
  .chev {
    flex: none;
    width: 9px;
    height: 9px;
    margin-right: 2px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  details[open] .chev {
    transform: rotate(225deg) translateY(-2px);
  }

  /* A altura é animada pela Web Animations API, no <script> abaixo. Duas tentativas
     anteriores (grid 0fr->1fr e ::details-content + interpolate-size) foram descartadas:
     a segunda não cria transição nenhuma no Chrome 148 — document.getAnimations() volta
     vazio e o painel estala. WAAPI com altura em px medida não depende de suporte a nada. */
  .faq-panel {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .chev {
      transition: none;
    }
  }
</style>

<script>
  // Progressive enhancement: o <details> segue sendo a fonte da verdade (teclado, leitor
  // de tela, Ctrl+F). O script só segura o attr `open` no fechamento pra a altura ter
  // tempo de animar — o nativo remove ele na hora. Sem JS, abre e fecha como sempre.
  const CURVA = 'cubic-bezier(0.4, 0, 0.2, 1)';
  const ABRIR = 380;
  const FECHAR = 300;

  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const item of document.querySelectorAll<HTMLDetailsElement>('.faq-item')) {
    const summary = item.querySelector('summary');
    const panel = item.querySelector<HTMLElement>('.faq-panel');
    const content = item.querySelector<HTMLElement>('.faq-content');
    if (!summary || !panel || !content) continue;

    summary.addEventListener('click', (e) => {
      if (semMovimento.matches) return; // deixa o nativo abrir e fechar seco
      e.preventDefault();
      if (item.dataset.animando) return; // ignora clique no meio da animação

      const abrindo = !item.open;
      item.dataset.animando = '';
      if (abrindo) item.open = true; // precisa estar aberto pra ter altura pra medir

      const altura = panel.scrollHeight;
      const duracao = abrindo ? ABRIR : FECHAR;

      const anim = panel.animate(
        { height: abrindo ? ['0px', `${altura}px`] : [`${altura}px`, '0px'] },
        { duration: duracao, easing: CURVA, fill: 'both' },
      );

      // O texto entra atrás da altura e sai na frente dela: abrir revela, fechar recolhe.
      const fade = content.animate(
        {
          opacity: abrindo ? [0, 1] : [1, 0],
          transform: abrindo ? ['translateY(-6px)', 'none'] : ['none', 'translateY(-6px)'],
        },
        {
          duration: abrindo ? 260 : 160,
          delay: abrindo ? 90 : 0,
          easing: CURVA,
          fill: 'both',
        },
      );

      anim.finished
        .catch(() => {}) // animação cancelada não é erro
        .then(() => {
          // Cancelar devolve altura/opacidade ao valor natural do CSS. Sem isso, cada
          // clique deixa uma animação com fill pendurada no elemento pra sempre.
          anim.cancel();
          fade.cancel();
          if (!abrindo) item.open = false;
          delete item.dataset.animando;
        });
    });
  }
</script>
