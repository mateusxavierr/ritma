---
/**
 * CTA final (PLANO §5.11): fechamento isolado no único bloco escuro da página,
 * eco do verso chumbo da papelaria. Contíguo ao footer (mesmo fundo).
 * id="cta-final" é observado pela sticky bar (§5.12): a barra some enquanto
 * este bloco estiver na viewport.
 */
import CtaButton from './CtaButton.astro';
---

<section id="cta-final" class="band-light cta-final text-center">
  <span class="texture-r-ink" aria-hidden="true"></span>
  <div class="container-page pt-16 pb-12 md:pt-24 md:pb-16">
    <h2 class="text-h2 reveal">Descubra hoje se a sua marca ainda está livre</h2>
    <p class="mx-auto mt-4 max-w-[36rem] text-(--text-secondary) reveal" style="--reveal-delay:100ms">
      Uma conversa no WhatsApp resolve. Se o nome estiver disponível, você decide o próximo passo
      com calma.
    </p>
    <div class="mt-8 reveal" style="--reveal-delay:180ms">
      <CtaButton variant="inverse" align="center" origin="final" />
    </div>
  </div>
</section>

<style>
  /* O remap de bloco escuro saiu em 2026-07-24: esta seção virou faixa CLARA e o footer
     escuro passou a fechar a página sozinho. Fundo branco (não o osso das outras claras)
     pra separar do footer chumbo logo abaixo. */
  .cta-final {
    background: var(--surface-page);
  }
</style>
