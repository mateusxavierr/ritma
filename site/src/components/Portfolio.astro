---
/**
 * Portfólio de proteção (PLANO §5.8): marca é o carro-chefe, direitos autorais é o segundo
 * confirmado. Must-fix 1 do council visual: o pattern de R atrás do texto matava a
 * legibilidade e rebaixava o card B. Agora os DOIS cards têm a mesma anatomia (borda +
 * fundo branco) e o pattern oficial vive numa faixa inferior contida, tom-sobre-tom
 * (branco sancionado sobre osso — §7), sem texto por cima.
 * Cards sem CTA próprio: CTA único da página (§10.9).
 */
import patternR from '../assets/pattern-r.svg';
---

<section class="bg-(--surface-page)">
  <div class="container-page py-16 md:py-24">
    <h2 class="text-h2 reveal">A marca é só o começo</h2>
    <p class="mt-3 max-w-[62ch] text-(--text-secondary) reveal" style="--reveal-delay:80ms">
      A Ritma protege os ativos que fazem o seu negócio valer alguma coisa.
    </p>
    <div class="mt-10 grid gap-4 md:grid-cols-2 md:gap-6">
      <div class="card-lift reveal rounded-xl border border-(--border-subtle) bg-(--surface-page) p-8">
        <h3 class="text-h3">Registro de marca</h3>
        <p class="mt-3 text-body-sm text-(--text-secondary)">
          O nome e a identidade do seu negócio, com exclusividade nacional renovável a cada 10 anos.
          É a espinha desta página inteira.
        </p>
      </div>
      <div class="card-lift reveal flex flex-col overflow-hidden rounded-xl border border-(--border-subtle) bg-(--surface-page)" style="--reveal-delay:100ms">
        <div class="p-8">
          <h3 class="text-h3">Direitos autorais</h3>
          <p class="mt-3 text-body-sm text-(--text-secondary)">
            Prova de autoria para o que você cria: logotipo, fotos, textos, músicas, código.
            Proteção reconhecida internacionalmente pela Convenção de Berna.
          </p>
        </div>
        <div
          aria-hidden="true"
          class="pattern-band mt-auto"
          style={`background-image: url(${patternR.src})`}
        >
        </div>
      </div>
    </div>
    {/*
      [PENDENTE:SERVICOS] — cards C+ (software, desenho industrial, monitoramento…) entram
      quando a lista real chegar (PERGUNTAS-ABERTAS 1). Fórmula de copy (§4.9):
      nome + definição em linguagem de dono + 1 benefício + assinatura de tempo. Ex.:

      <div class="rounded-xl border border-(--border-subtle) p-8">
        <h3 class="text-h3">NOME DO SERVIÇO</h3>
        <p class="mt-3 text-body-sm text-(--text-secondary)">DEFINIÇÃO + BENEFÍCIO + TEMPO.</p>
      </div>
    */}
  </div>
</section>

<style>
  /* Faixa de pattern oficial de R, tom-sobre-tom (branco sancionado sobre osso — §5.8, §7).
     Zona puramente decorativa: nenhum texto por cima (must-fix 1 do council visual). */
  .pattern-band {
    height: 64px;
    background-color: var(--surface-alt);
    background-size: 170px auto;
    background-repeat: repeat;
  }

  /* Relevo sutil dos cards sobre a textura (profundidade — feedback do Mateus) */
  .card-lift {
    box-shadow: 0 1px 2px rgb(76 78 78 / 0.05), 0 8px 24px rgb(76 78 78 / 0.06);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .card-lift:hover {
    transform: translateY(-3px);
    box-shadow: 0 2px 4px rgb(76 78 78 / 0.06), 0 14px 34px rgb(76 78 78 / 0.1);
  }
</style>
